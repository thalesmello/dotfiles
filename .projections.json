{
  "stow_modules/main/dot-config/fish/fundle/*.fish": {"type": "fishplugin"},
  "stow_modules/main/dot-config/fish/completions/*.fish": {"type": "fishcompletion"},
  "stow_modules/main/dot-config/fish/functions/*.fish": {
    "type": "fishfunction",
    "template": [
      "function {}",
      "end"
    ]
  },
  "stow_modules/main/dot-config/fish/conf.d/*.fish": {"type": "fishconf"},
  "stow_modules/main/dot-config/fish/config.fish": {"type": "fishinit"},
  "README.md": {"type": "doc"},
  "stow_modules/main/dot-config/karabiner.edn": { "type": "karabiner", "dispatch": "goku" },
  "stow_modules/main/dot-config/nvim/lua/config/*.lua":{
    "type":"config"
  },
  "stow_modules/main/dot-config/nvim/lua/plugins/*.lua":{
    "type":"plugin",
    "dispatch": "nvr --nostart -cc \"lua require'vim_utils'.reload_lazy_file('plugin.{}')\"",
    "template": [
      "  return {",
      "  {",
      "  \"plugin\",",
      "  -- opts:{}",
      "  -- config:function () end",
      "  }",
      "}"
    ]
  },
  "stow_modules/main/dot-config/nvim/lua/*.lua":{
    "type":"lua",
    "dispatch": "nvr --nostart -cc \"source {file}\""
  },
  "stow_modules/main/dot-config/nvim/local_plugins/**/lua/*.lua":{
    "type":"localplugins"
  },
  "stow_modules/main/dot-config/nvim/after/queries/*/textobjects.scm":{
    "type":"textobjects"
  },
  "stow_modules/main/dot-config/nvim/lua/ftmini/*.lua":{
    "type":"ftmini"
  }
}
