#!/usr/bin/env -S fish --no-config
set -x PATH /opt/homebrew/bin (status dirname) $PATH

# Generic counterpart of meta-preset: acts on the current selection/clipboard,
# opening files in nvim and URLs in Chrome. No work-specific branches here —
# on a Meta machine this name is a symlink to meta-preset instead.

function __workflow_preset_default
    for val in $argv
        if test -n "$val"
            echo $val
            return 0
        end
    end
    return 1
end

# The one dictionary of selection types, shared by `pick-selections`,
# `get-selection-type` and `open-selection-type`. One record per line, tab
# separated:
#
#   <type>  <pattern>  <url>
#
#   type      the name every preset routes on. It is what rxpick tags a pick
#             with, what the hammerspoon:// links carry, and what
#             open-selection-type switches on. A url written with a scheme and
#             one written without are separate types (`url` and
#             `implicit_url`) because they open through different templates.
#   pattern   a regex matching the thing and nothing more, with no anchors of
#             its own.
#   url       where the type opens, with `{match}` standing in for the text,
#             or `-` when the action is not a url at all (path/file go to
#             nvim). This is the same `{match}` template rxpick renders, so
#             `pick-selections` hands the string straight to `-f` and
#             open-selection-type fills it in itself -- one destination per
#             type, written once.
#
# Both callers wrap the pattern the same way -- (?<!\w)(?:...)(?!\w) -- and
# both look for it ANYWHERE in their input, so a selection does not have to be
# nothing but the thing: `see notes.md for details` is a file. Whatever the
# pattern matched is what gets acted on, never the surrounding text. The
# delimiters are what keep a token from being found inside a longer one; they
# are exactly \b...\b for a pattern bounded by word characters, but unlike \b
# they also work for the ones that start with `/` or `~`.
#
# The two differ only in what they do with more than one hit. `pick-selections`
# offers every one of them as a menu over a whole pane; `get-selection-type`
# has a single string and must choose, so it takes the LEFTMOST match and uses
# the order below only to break ties at the same offset. Leftmost is what makes
# `docs/README.md` a path rather than the file `README.md` hiding inside it.
#
# Order therefore matters at equal offsets: implicit_url before path so
# `example.com/a` is a host and not a relative path; file after both because
# .md and .sh are TLDs too. The work-specific types live in meta-preset.
function __workflow_preset_selection_types
    # Trailing delimiters a url must not swallow, kept identical to rxpick's
    # own builtin so a pick and a selection agree on where a url ends. Quotes
    # and brackets are what a url is WRAPPED in far more often than what it
    # contains -- true even of `'`, which RFC 3986 does allow -- and braces
    # cannot appear unescaped at all, so `'https://{match_raw}'` is a template
    # rather than a url however much it looks like one.
    set -l url_tail '[^\s<>"'"'"'`|)\]{}]'

    printf '%s\t%s\t%s\n' \
        url "https?://$url_tail+" '{match_raw}' \
        implicit_url "[a-zA-Z0-9_.-]+\.[a-zA-Z]{2,}/$url_tail*" 'https://{match_raw}' \
        path '~?/?[\w.~+@%-]+(?:/[\w.~+@%-]*)+' - \
        file '[a-zA-Z0-9_.-]+\.(py|js|jsx|mjs|cjs|ts|tsx|rb|php|html|htm|css|scss|c|cc|cpp|h|hpp|java|go|rs|lua|sh|fish|pl|r|swift|kt|scala|sql|vim|hs|md|txt|toml|json|yaml|yml|xml|csv|ini|cfg|conf)' -
end

# The url a type opens, with {match} filled in, or nothing when the type does
# not open one. A type may still have several records, so pick the record whose
# pattern describes THIS match rather than the first one bearing the name.
function __workflow_preset_selection_url --argument-names type match
    for record in (__workflow_preset_selection_types)
        set -l fields (string split \t -- $record)
        test "$fields[1]" = "$type"; or continue
        test "$fields[3]" = -; and return 1

        if test "$fields[2]" != -
            string match -qr -- (string join '' '^(?:' $fields[2] ')$') "$match"; or continue
        end

        # {match} and {match_raw} differ only for rxpick, which percent-encodes
        # the first. Nothing is being spliced into a query string here that did
        # not arrive in one, so both are just the text.
        string replace --all '{match_raw}' "$match" -- "$fields[3]" \
            | string replace --all '{match}' "$match"
        return 0
    end

    return 1
end

# Name a selection: prints "<type>\t<match>", where match is the text the
# action should run against, with line-wraps joined back up. Returns 1 when
# nothing in the dictionary claims it.
function __workflow_preset_get_selection_type
    argparse 'content-only' 'app=' -- $argv
    or return 1

    set -l selection
    if set -q argv[1]
        set selection $argv[1]
    else
        read -z selection
    end

    set selection "$(string trim -- $selection | string trim --left --chars='(' | string trim --right --chars='),.:')"

    set -q _flag_app; or set _flag_app (hs-preset get-active-app)

    # --content-only routes purely on what the text looks like. The app check
    # below exists to read the CURRENT app's context (what is selected, which
    # page Chrome is on), which is meaningless once the text was picked
    # deliberately -- e.g. a hammerspoon:// link, where the frontmost app by the
    # time this runs is Hammerspoon or whatever the link was clicked in.
    if set -q _flag_content_only
        or test "$_flag_app" = "iTerm2" -o "$_flag_app" = "Ghostty" -o "$_flag_app" = "Code"
        or iterm-preset is-floating-window-active

        # Claude Code wraps long URLs/paths across lines; join them back up so a
        # wrapped path still reads as one path.
        set -l joined (string replace -ra '\n\s*' '' -- "$selection")

        # Leftmost hit wins, dictionary order breaks ties. The lazy prefix is
        # how the offset is recovered -- fish has no match-position output, so
        # the length of what the pattern had to skip stands in for it.
        set -l best_type
        set -l best_hit
        set -l best_at

        for record in (__workflow_preset_selection_types)
            set -l fields (string split \t -- $record)
            test "$fields[2]" = -; and continue

            set -l re (string join '' '^(?<pre>[\s\S]*?)(?<hit>(?<!\w)(?:' $fields[2] ')(?!\w))')

            set -l pre
            set -l hit
            string match -rq -- $re "$joined"; or continue

            set -l at (string length -- "$pre")
            if not set -q best_at[1]; or test $at -lt $best_at
                set best_type "$fields[1]"
                set best_hit "$hit"
                set best_at $at
            end

            test $best_at -eq 0; and break
        end

        if set -q best_type[1]
            printf '%s\t%s\n' "$best_type" "$best_hit"
            return 0
        end
    else if test "$_flag_app" = "Google Chrome"
        # In Chrome only an explicit link is worth acting on -- everything else
        # is already where it belongs.
        if string match -qr '^https?://' -- "$selection"
            printf '%s\t%s\n' url "$selection"
            return 0
        end
    end

    return 1
end

# Run the action for a named type against the text get-selection-type (or
# rxpick, through a hammerspoon:// link) produced.
function __workflow_preset_open_selection_type
    argparse 'app=' -- $argv
    or return 1

    set -l type "$argv[1]"; set -e argv[1]
    set -l match "$argv[1]"

    # Anything with a url in the dictionary opens the same way; the dictionary
    # is the only place a destination is written down.
    set -l url (__workflow_preset_selection_url "$type" "$match")
    if test -n "$url"
        chrome-preset open-url --profile "Default" "$url" --newtabright --label "$type"
        return
    end

    switch "$type"
    case path file directory
        # `directory` is not in the dictionary -- a pattern alone cannot tell a
        # directory from a file -- but old hammerspoon:// links still carry it,
        # and it opens the same way.
        __workflow_preset_open_in_nvim "$_flag_app" "$match"
    case '*'
        return 1
    end
end

# Empty <app> means "work it out". Which surface nvim lands in is the only
# thing the app is for, so it is resolved here, as late as possible: the herdr
# branch below never needs it, and that is the branch the picker takes -- on a
# herdr server there may be no `hs` to ask.
function __workflow_preset_open_in_nvim --argument-names app path
    # Two commands by design: new-split makes the terminal split, and the
    # command it runs drives nvim into the right pane (remoting to a sibling
    # nvim if one exists, else opening nvim in the split).
    if set -q HERDR_PANE_ID; or set -q HERDR_ACTIVE_PANE_ID
        # Already inside herdr (e.g. the pick-selection split): talk to it
        # directly. Going through ghostty-preset would take the long way
        # round -- hammerspoon synthesising the run-command chord to reach
        # the same herdr-preset call from a popup.
        herdr-preset open-file-with-fallback "$path"
        return
    end

    # The focused window rather than get-active-app: this picks the
    # DESTINATION, not the context the text came from.
    test -n "$app"; or set app (hs-preset get-focused-window-app)

    if test "$app" = "Ghostty"
        # ghostty-preset decides: herdr surface -> open in a herdr pane
        # (reuse an existing nvim or make a herdr split); otherwise a native
        # Ghostty split driving nvim-open-in-tab.
        ghostty-preset open-file-with-fallback "$path"
    else if test "$app" = "iTerm2" -o "$app" = "Code"
        iterm-preset new-split --vertical -c "$(printf 'iterm-preset nvim-open-in-tab "%s"' $path)"
    else
        # The text came from something that is not a terminal (a clicked
        # hammerspoon:// link, say). open-file-with-fallback drives the
        # focused surface, so Ghostty has to be in front first.
        open -a Ghostty
        sleep 0.3
        ghostty-preset open-file-with-fallback "$path"
    end
end

# Name a selection and act on it in one go.
function __workflow_preset_selector
    argparse 'fallback-alfred' 'content-only' 'app=' -- $argv
    or return 1

    set -l selection
    if set -q argv[1]
        set selection $argv[1]
    else
        read -z selection
    end

    set selection "$(string trim -- $selection | string trim --left --chars='(' | string trim --right --chars='),.:')"

    set -q _flag_app; or set _flag_app (hs-preset get-active-app)

    set -l type_args --app "$_flag_app"
    set -q _flag_content_only; and set -a type_args --content-only

    set -l named (__workflow_preset_get_selection_type $type_args -- $selection)

    if test -n "$named"
        set -l fields (string split \t -- $named)
        set -l match ""
        set -q fields[2]; and set match "$fields[2]"

        __workflow_preset_open_selection_type --app "$_flag_app" -- "$fields[1]" "$match"
        and return 0
    end

    if set -q _flag_fallback_alfred; and not string match -qr '^https?://' -- "$selection"
        echo "$selection" | ua
    else
        return 1
    end
end

set preset $argv[1]; set -e argv[1]

switch "$preset"
case "get-page-id"
    set old_clipboard "$(pbpaste)"
    set focused_app "$(hs-preset get-focused-window-app)"

    if test "$focused_app" = "Google Chrome"
        set url $argv[1]; set -e argv[1]
        set value (__workflow_preset_default "$url" "$(env OUTPUT_FORMAT=json chrome-cli info | jq -r '.url')" "$(pbpaste)")
    else if test "$focused_app" = "iTerm2" -o "$focused_app" = "Ghostty"
        if string match -qr '\n\s+' "$old_clipboard"
            set value (string replace -ra '\n\s*' '' "$old_clipboard")
        end
    end

    if test -n "$value"
        echo "$value"
    else
        return 1
    end

case "selector"
    __workflow_preset_selector $argv

case "get-selection-type"
    __workflow_preset_get_selection_type $argv

case "open-selection-type"
    __workflow_preset_open_selection_type $argv

case "pick-selections"
    # Interactively pick matches out of piped terminal output (stdin) and print
    # the chosen ones, one per line. The types come straight out of the shared
    # dictionary, so a pick and a selection are always named the same thing and
    # the hammerspoon:// link a pick renders feeds open-selection-type directly.
    #
    # Where rxpick has a builtin for a type, the builtin is used instead of the
    # dictionary's pattern: it asks the filesystem, which a regex cannot, so it
    # only offers paths that are really there and knows which of them is a file
    # and which a directory. `path` therefore becomes those two builtins, and
    # the dictionary's `file` needs no line of its own -- a builtin file is
    # anything that exists and looks like a path (a slash or an extension), so
    # it catches the extensionless `~/bashrc` that no list of suffixes would.
    # The types with no builtin are still passed as their pattern.
    set -l rxpick_args
    for record in (__workflow_preset_selection_types)
        set -l fields (string split \t -- $record)
        test "$fields[2]" = -; and continue

        switch "$fields[1]"
        case url
            set -a rxpick_args -b url
        case path
            set -a rxpick_args -b file -b directory
        case file
            continue
        case '*'
            set -a rxpick_args -t "$fields[1]" (string join '' '(?<!\w)(?:' $fields[2] ')(?!\w)')
        end

        # A type that knows where it opens gets a direct clickable link, as
        # long as the template survives rxpick's rendering: it percent-encodes
        # {match} (right inside a query string, fatal when the match IS the
        # url) and leaves {match_raw} alone. Either of those is safe to hand
        # over; anything else falls through to whatever --default-url-format
        # the caller passed -- the hammerspoon:// round trip, which is the
        # only way to reach the types whose action is local (nvim).
        if string match -qr '\{match_raw\}|\?[^?]*\{match\}' -- "$fields[3]"
            set -a rxpick_args -f "$fields[3]"
        end
    end

    # The catch-all for types with no url of their own: bounce off hammerspoon,
    # which runs open-selection-type back here (see workflowPreset.lua). It is
    # the only way to reach an action that is not a url -- nvim cannot be driven
    # by a link -- and it belongs next to the dictionary rather than in each
    # caller. First wins in rxpick's parser is LAST wins, so a caller passing
    # its own --default-url-format still overrides this.
    set -l default_url 'hammerspoon://workflow-preset/open-selection?type={type}&match={match}'

    rxpick -B --default-url-format $default_url $rxpick_args $argv

case "open-selection"
    set active_app "$(hs-preset get-focused-window-app)"

    if set -q argv[1]
        # Explicit text (e.g. piped in from `pick-selections`, or handed over by
        # a hammerspoon:// link) wins over whatever is selected/copied right
        # now, and routes on the text alone: the frontmost app is no longer the
        # context the text came from.
        __workflow_preset_selector --content-only --app "$active_app" -- "$argv[1]"
        or return 1
        return 0
    end

    set clipboard "$(pbpaste)"
    set selection "$(hs-preset get-selected-text)"

    set -l selector_input "$(test -n "$selection"; and echo "$selection"; or echo "$clipboard")"
    __workflow_preset_selector --app "$active_app" -- "$selector_input"
    or return 1

case "*"
    return 1
end
