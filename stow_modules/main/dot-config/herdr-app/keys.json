  "terminal": {
    "cmd-f": "terminal.search",
    "cmd-c": "terminal.copy",
    "cmd-v": "terminal.paste",
    "ctrl-v": "terminal.paste_image",
    "cmd-k": "send:\u000c",
    "cmd-pageup": {
      "command": "terminal.scroll",
      "args": {
        "pages": -1
      }
    },
    "cmd-pagedown": {
      "command": "terminal.scroll",
      "args": {
        "pages": 1
      }
    },
    "cmd-home": {
      "command": "terminal.scroll",
      "args": {
        "to": "top"
      }
    },
    "cmd-end": {
      "command": "terminal.scroll",
      "args": {
        "to": "bottom"
      }
    },
    "alt-left": "send:\u001bb",
    "alt-right": "send:\u001bf",
    "alt-backspace": "send:\u0017",
    "cmd-left": "send:\u0001",
    "cmd-right": "send:\u0005",
