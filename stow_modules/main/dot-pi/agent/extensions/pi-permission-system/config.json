{
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "permissionDialogKeys": {
    "approve": "y",
    "approveSession": "s",
    "approveGlobal": "g",
    "approveSessionBoth": "b",
    "deny": "n",
    "denyWithReason": "r"
  },
  "promptNotifications": ["bell"],
  "authorizerChain": ["auto-review"],
  "commandEffects": {
    "git": {
      "unlessOption": ["--output"],
      "subcommands": { "log": "read", "status": "read", "diff": "read", "show": "read", "branch": "read", "remote": "read" }
    },
    "sl": {
      "subcommands": { "log": "read", "status": "read", "diff": "read", "show": "read" }
    }
  },
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny"
    },
    "path_write": {
      "~/.ssh/*": "deny"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "skill": {
      "*": "allow"
    },
    "external_directory_read": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/src/*": "allow",
      "~/fbsource/*": "allow",
      "~/www/*": "allow",
      "~/notes/*": "allow",
      "~/.pi/*": "allow",
      "~/.claude/*": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "jq *": "allow",
      "diff *": "allow",
      "stat *": "allow",
      "which *": "allow",
      "file *": "allow",
      "date *": "allow",
      "sleep *": "allow",
      "true": "allow",
      "false": "allow",
      "test *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git check-ignore*": "allow",
      "sl status*": "allow",
      "sl log*": "allow",
      "sl diff*": "allow",
      "sl show*": "allow",
      "mkdir -p /tmp/*": "allow",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~*": "deny"
    }
  }
}
