{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": true,
  "doublePressToConfirm": true,
  "permissionDialogKeys": {
    "approve": "y",
    "approveSession": "s",
    "approveGlobal": "g",
    "approveSessionBoth": "b",
    "explainAllow": "e",
    "deny": "n",
    "denyWithReason": "r"
  },
  "promptNotifications": [
    "bell"
  ],
  "authorizerChain": [
    "auto-review"
  ],
  "commandEffects": {
    "git": {
      "unlessOption": [
        "--output"
      ],
      "subcommands": {
        "log": "read",
        "status": "read",
        "diff": "read",
        "show": "read",
        "branch": "read",
        "remote": "read"
      }
    },
    "sl": {
      "subcommands": {
        "log": "read",
        "status": "read",
        "diff": "read",
        "show": "read"
      }
    },
    "strings": {
      "effects": "read"
    },
    "otool": {
      "effects": "read"
    },
    "nm": {
      "effects": "read"
    },
    "ps": {
      "effects": []
    },
    "herdr": {
      "effects": []
    },
    "hc": {
      "effects": []
    },
    "herdr-app": {
      "effects": []
    },
    "hc-preset": {
      "effects": []
    }
  },
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny"
    },
    "path_write": {
      "~/.ssh/*": "deny"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "skill": {
      "*": "allow"
    },
    "external_directory_read": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow",
      "/opt/homebrew/*": "allow",
      "~/src/*": "allow",
      "~/fbsource/*": "allow",
      "~/www/*": "allow",
      "~/notes/*": "allow",
      "~/.pi/*": "allow",
      "~/.claude/*": "allow"
    },
    "bash": {
      "*": "ask",
      "cd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "jq *": "allow",
      "diff *": "allow",
      "stat *": "allow",
      "which *": "allow",
      "file *": "allow",
      "strings *": "allow",
      "otool *": "allow",
      "nm *": "allow",
      "ps": "allow",
      "ps *": "allow",
      "herdr *": "allow",
      "hc *": "allow",
      "herdr-app *": "allow",
      "hc-preset *": "allow",
      "xcrun --show-sdk-path*": "allow",
      "xcrun --find *": "allow",
      "date *": "allow",
      "sleep *": "allow",
      "true": "allow",
      "false": "allow",
      "test *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git check-ignore*": "allow",
      "git -C * status*": "allow",
      "git -C * log*": "allow",
      "git -C * diff*": "allow",
      "git -C * show*": "allow",
      "git -C * branch*": "allow",
      "git -C * remote*": "allow",
      "git -C * rev-parse*": "allow",
      "git -C * check-ignore*": "allow",
      "sl status*": "allow",
      "sl log*": "allow",
      "sl diff*": "allow",
      "sl show*": "allow",
      "mkdir -p /tmp/*": "allow",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~*": "deny"
    }
  }
}
