#!/usr/bin/env -S fish --no-config
set -x PATH /opt/homebrew/bin (status dirname) $PATH

# Thin shim over termPreset.lua (Hammerspoon). Each subcommand dispatches to the
# matching function there via a single `hs -c`, so there is ONE implementation
# shared by the CLI callers and the Hammerspoon keybindings -- except the
# keybindings call the module directly (in-process) rather than through this
# shim, which is what removes the per-keystroke `hs -c` mach-port race.
#
# This replaces a fan-out that was more expensive than it looked: every
# subcommand called iterm-preset AND ghostty-preset, and both of those are
# themselves `hs -c` shims, so one `term-preset hide-floating-terminal` meant two
# round trips into Hammerspoon plus three fish startups. termPreset.lua does the
# fan-out in process.

# Run a Lua boolean predicate and map it to this process's exit code, so the
# `case is-*` predicates keep working in `if` / `and` / `or`.
function __tp_bool
    test "$(hs -c "if $argv[1] then print('yes') end")" = yes
end

function term-preset
    set preset $argv[1]
    set -e argv[1]

    switch "$preset"
    case "is-floating-terminal"
        # Exit 0 when EITHER terminal's floating window is active.
        __tp_bool "require('termPreset').isFloatingTerminal()"

    case "hide-floating-terminal"
        # Hides whichever floating terminal is active; each branch inside is
        # guarded, so calling it when neither is up is a no-op.
        hs -c "require('termPreset').hideFloatingTerminal()"

    case "iterate-windows"
        # Iterate iTerm + Ghostty windows as one app. Same flags as
        # `iterm-preset iterate-windows` / `ghostty-preset iterate-windows`.
        argparse 'except-window-id=' 'prev' -- $argv
        or return 1

        set -l except ""
        set -q _flag_except_window_id; and set except "$_flag_except_window_id"
        set -l prev (set -q _flag_prev; and echo true; or echo false)

        hs -c "require('termPreset').iterateWindows({exceptId='$except', prev=$prev})"

    case "*"
        return 1
    end
end

term-preset $argv
