#!/usr/bin/env -S fish --no-config
set -x PATH /opt/homebrew/bin (status dirname) $PATH

# Thin shim over ghosttyPreset.lua (Hammerspoon). Each subcommand dispatches to
# the matching function there via a single `hs -c`, so there is ONE
# implementation shared by the CLI callers (term-preset, meta-preset,
# herdr-preset) and the Hammerspoon keybindings -- except the keybindings call
# the module directly (in-process) rather than through this shim, which is what
# removes the per-keystroke `hs -c` mach-port race.
#
# nvim-tab-remote / nvim-open-in-tab stay implemented here in fish: they depend
# on the caller's shell environment ($NVIM, $TMUX, cwd) and tools (nvim
# --server, tmux, lsof, /proc), none of which are reachable from inside
# Hammerspoon.

# Run a Lua boolean predicate and map it to this process's exit code, so the
# `case is-*` predicates keep working in `if` / `and` / `or`.
function __gp_bool
    test "$(hs -c "if $argv[1] then print('yes') end")" = yes
end

function ghostty-preset
    set preset $argv[1]
    set -e argv[1]

    switch "$preset"
    case "new-window"
        hs -c "require('ghosttyPreset').newWindow()"

    case "new-split"
        # -v/--vertical = left/right divider; default/-h = top/bottom divider.
        argparse 'v/vertical' 'h/horizontal' 'c/cmd=' -- $argv
        or return 1

        set -l vert (set -q _flag_vertical; and echo true; or echo false)

        if set -q _flag_cmd
            # Pass the command base64-encoded to sidestep three layers of quoting
            # (fish -> hs -c shell arg -> Lua string). ghosttyPreset decodes it.
            set -l enc (printf '%s' "$_flag_cmd" | base64 | tr -d '\n')
            hs -c "require('ghosttyPreset').newSplit({vertical=$vert, cmd=hs.base64.decode('$enc')})"
        else
            hs -c "require('ghosttyPreset').newSplit({vertical=$vert})"
        end

    case "new-tab"
        hs -c "require('ghosttyPreset').newTab()"

    case "is-zoomed-or-single-surface"
        __gp_bool "require('ghosttyPreset').isZoomedOrSingleSurface()"

    case "is-zoomed"
        __gp_bool "require('ghosttyPreset').isZoomed()"

    case "is-floating-terminal"
        __gp_bool "require('ghosttyPreset').isFloatingTerminal()"

    case "is-herdr-window"
        __gp_bool "require('ghosttyPreset').isHerdrWindow()"

    case "is-multiplexer-window"
        __gp_bool "require('ghosttyPreset').isMultiplexerWindow()"

    case "is-herdr-zoomed-or-single-surface"
        __gp_bool "require('ghosttyPreset').isHerdrZoomedOrSingleSurface()"

    case "is-multiplexer-app-zoomed-or-single-surface"
        __gp_bool "require('ghosttyPreset').isMultiplexerAppZoomedOrSingleSurface()"

    case "new-split-with-fallback"
        # Default (no flag) and -h -> horizontal; only -v -> vertical. Matches the
        # original fish semantics; the keybinding passes an explicit flag.
        argparse 'v/vertical' 'h/horizontal' -- $argv
        or return 1
        set -l horiz (set -q _flag_vertical; and echo false; or echo true)
        hs -c "require('ghosttyPreset').newSplitWithFallback($horiz)"

    case "new-tab-with-fallback"
        hs -c "require('ghosttyPreset').newTabWithFallback()"

    case "new-window-with-fallback"
        hs -c "require('ghosttyPreset').newWindowWithFallback()"

    case "focus-tab-with-fallback"
        hs -c "require('ghosttyPreset').focusTabWithFallback('$argv[1]')"

    case "close-pane-with-fallback"
        hs -c "require('ghosttyPreset').closePaneWithFallback()"

    case "focus-pane-with-fallback"
        hs -c "require('ghosttyPreset').focusPaneWithFallback('$argv[1]')"

    case "reveal-floating-terminal"
        hs -c "require('ghosttyPreset').revealFloatingTerminal()"

    case "hide-floating-terminal"
        hs -c "require('ghosttyPreset').hideFloatingTerminal()"

    case "open-file-with-fallback"
        # Dispatch to ghosttyPreset.openFileWithFallback (herdr-aware). base64 the
        # path so it survives fish -> hs -c shell arg -> Lua without quoting.
        set -l enc (printf '%s' "$argv[1]" | base64 | tr -d '\n')
        hs -c "require('ghosttyPreset').openFileWithFallback(hs.base64.decode('$enc'))"

    case "iterate-windows"
        argparse 'except-window-id=' 'prev' -- $argv
        or return 1
        set -l except ""
        set -q _flag_except_window_id; and set except "$_flag_except_window_id"
        set -l prev (set -q _flag_prev; and echo true; or echo false)
        hs -c "require('ghosttyPreset').iterateWindows({exceptId='$except', prev=$prev})"

    case "nvim-tab-remote"
        function __exit_on_error -a message
            echo "Error: $message" >&2
            exit 1
        end

        # Fast path: already inside an nvim terminal.
        if set -q NVIM
            nvim --server "$NVIM" $argv
            or __exit_on_error "nvim --server exited with an error"
            return
        end

        # Under tmux the sibling-pane lookup is terminal-agnostic (tmux gives us
        # the tab's ttys), so reuse the socket path unchanged. This is the
        # dev-preset / devserver case and works identically in Ghostty.
        if test -n "$TMUX"
            set -l servers (nvim --headless -c 'lua for _, s in ipairs(vim.fn.serverlist({peer=true})) do print(s) end' -c 'qa!' 2>&1)
            or __exit_on_error "failed to list nvim servers"

            set tab_ttys (tmux list-panes -F '#{pane_tty}')
            or __exit_on_error "failed to get tab ttys"

            set -l found_server
            for server in $servers
                set -l nvim_pid (string match -r 'nvim\.(\d+)\.' "$server")[2]
                if test -n "$nvim_pid"
                    if test -d /proc/$nvim_pid/fd
                        set nvim_tty (readlink /proc/$nvim_pid/fd/0 2>/dev/null)
                    else
                        set nvim_tty (lsof -p "$nvim_pid" 2>/dev/null | string match -r '/dev/ttys\d+' | head -1)
                    end
                    if contains -- "$nvim_tty" $tab_ttys
                        set found_server "$server"
                        break
                    end
                end
            end

            if test -n "$found_server"
                nvim --server "$found_server" $argv
            else
                nvim $argv
            end
            or __exit_on_error "nvim exited with an error"
            return
        end

        # Bare Ghostty (no tmux): no tty means no server->pane correlation.
        # Drive the sibling nvim by keystrokes, located by its "nvim:" title
        # marker (set via titlestring in nvim config). If none is found, exec
        # nvim in this split (repurposing the split new-split created for us).
        argparse 'remote' -- $argv
        or return 1
        set -l file $argv[1]

        set -l drop_script '
on run argv
    set filePath to item 1 of argv
    tell application id "com.mitchellh.ghostty"
        try
            set target to (first terminal of selected tab of front window whose name starts with "nvim:")
        on error
            return "no"
        end try
        -- 1) force normal mode
        send key "\\" modifiers "control" to target
        send key "n" modifiers "control" to target
        -- 2) open cmdline with an explicit keypress
        send key ":" to target
        -- 3) paste the path literally (cmdline paste inserts literally)
        input text ("drop " & filePath) to target
        -- 4) execute
        send key "enter" to target
        return "yes"
    end tell
end run
'
        set -l found (osascript -e "$drop_script" "$file")

        if test "$found" != "yes"
            exec nvim $file
        end

    case "nvim-open-in-tab"
        set -l file (realpath "$(eval echo $argv[1])" 2>/dev/null)
        or begin
            echo "Error: file not found: $argv[1]" >&2
            exit 1
        end

        ghostty-preset nvim-tab-remote --remote "$file"

    case "*"
        return 1
    end
end

ghostty-preset $argv
