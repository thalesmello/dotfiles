#!/usr/bin/env -S fish --no-config
set -x PATH /opt/homebrew/bin (status dirname) $PATH

# Standalone Ghostty counterpart to iterm-preset. Same subcommand names, backed
# by Ghostty AppleScript. Ghostty exposes application -> windows -> tabs ->
# terminals (a `terminal` is one split surface) and no tty/pid.
#
# Address the app by bundle id; targeting by name "Ghostty" errors -600.
set -g GHOSTTY_ID 'application id "com.mitchellh.ghostty"'

# Exactly one visible surface (AX, checked in Hammerspoon): zoomed OR a genuine
# single pane. Direct `hs -c` (no ghostty-preset/hs-preset re-spawn), cheap
# enough for the per-keystroke path.
function __ghostty_zoomed_or_single_surface
    test "$(hs -c 'if require("preset").isGhosttyZoomedOrSingleSurface() then print("yes") end')" = "yes"
end

# Zoomed = one visible surface AND the active tab still has >1 logical split. The
# logical-split count runs here via osascript in a subprocess, NOT inside
# Hammerspoon where hs.osascript would block the event loop.
function __ghostty_is_zoomed
    __ghostty_zoomed_or_single_surface
    or return 1
    set -l logical (osascript -e 'tell application id "com.mitchellh.ghostty" to count of terminals of selected tab of front window')
    test "$logical" -gt 1 2>/dev/null
end

# Exit 0 when Ghostty's quick (floating) terminal is the focused window. Direct
# `hs -c` (no re-spawn) so it's cheap on the per-keystroke focus path.
function __ghostty_is_floating_terminal
    test "$(hs -c 'if require("preset").isGhosttyQuickTerminalActive() then print("yes") end')" = "yes"
end

# Exit 0 when the front window is a lone herdr session: exactly one tab, exactly
# one pane (a real single surface -- `count of terminals` counts logical splits,
# so a zoomed multi-split reports >1 and is excluded), and that pane's title
# identifies herdr. Exit 1 otherwise (including no window / AppleScript error).
function __ghostty_is_herdr_zoomed_or_single_surface
    test "$(hs -c 'if require("preset").isGhosttyHerdrZoomedOrSingleSurface() then print("yes") end')" = "yes"
end

# Exit 0 when the focused window shows a single surface (zoomed or lone pane)
# running a multiplexer -- nvim or herdr -- so pane-nav keys should go to it.
function __ghostty_is_multiplexer_app_zoomed_or_single_surface
    test "$(hs -c 'if require("preset").isGhosttyMultiplexerZoomedOrSingleSurface() then print("yes") end')" = "yes"
end

function __ghostty_is_herdr_window
    test "$(osascript -e '
        tell application id "com.mitchellh.ghostty"
            try
                set win to front window
                if (count of tabs of win) is not 1 then return "no"
                set tb to item 1 of tabs of win
                if (count of terminals of tb) is not 1 then return "no"
                set t to item 1 of terminals of tb
                if (name of t) starts with "herdr" then return "yes"
            end try
            return "no"
        end tell
    ')" = "yes"
end

function ghostty-preset
    set preset $argv[1]
    set -e argv[1]

    switch "$preset"
    case "new-window"
        osascript -e 'tell application id "com.mitchellh.ghostty" to new window'

    case "new-split"
        # -v/--vertical = left/right divider = Ghostty `direction right`
        # -h/--horizontal = top/bottom divider = Ghostty `direction down`
        argparse 'v/vertical' 'h/horizontal' 'c/cmd=' -- $argv
        or return 1

        if set -q _flag_vertical
            set direction right
        else
            set direction down
        end

        if set -q _flag_cmd
            # Create the split with the command baked into Ghostty's surface
            # configuration (instead of the old `input text "exec fish -c ..."`
            # hack that typed into the split's default login shell).
            #
            # Semantics we want (mirror iterm-preset new-split -c):
            #   * CMD succeeds -> the split closes cleanly, no error screen.
            #   * CMD errors   -> keep the split open showing the output.
            #
            # Why we CLOSE the split ourselves on success instead of leaning on
            # Ghostty's close-on-exit (`wait after command:false`):
            # Ghostty flags any surface whose process exits faster than
            # `abnormal-command-exit-runtime` (default 250ms) as an "abnormal"
            # exit and shows the red "Ghostty failed to launch the requested
            # command" box. On macOS that fires for ANY exit code (see
            # ghostty.5.md), so a fast success like `echo hello world` would
            # still pop the box. Closing the surface via AppleScript is a
            # script-initiated teardown, not a process exit, so it never trips
            # the abnormal-exit detector. `wait after command:false` still
            # governs the error path: after the user dismisses `read`, fish
            # exits and Ghostty closes the surface (a slow exit -> no box).
            set -l close_cmd "osascript -e 'tell application id \"com.mitchellh.ghostty\" to close (focused terminal of selected tab of front window)'"
            set -l inner "$_flag_cmd; and $close_cmd; or read -P 'Press Enter to close'"

            # Ghostty runs a `command` with arguments via `/bin/sh -c`, so wrap
            # the fish invocation in single quotes for that shell (escaping any
            # embedded single quote the POSIX way: ' -> '\'').
            set -l sq (string replace -a "'" "'\\''" -- "$inner")
            set -l command_value "fish -c '$sq'"

            # Direction is a controlled keyword (interpolated); the command
            # string is passed as argv so it needs no AppleScript escaping.
            set -l script '
on run argv
    set cmdText to item 1 of argv
    tell application id "com.mitchellh.ghostty"
        split (focused terminal of selected tab of front window) direction '$direction' with configuration {command:cmdText, wait after command:false}
    end tell
end run
'
            osascript -e "$script" "$command_value"
        else
            osascript -e "tell application id \"com.mitchellh.ghostty\" to split (focused terminal of selected tab of front window) direction $direction"
        end

    case "is-zoomed-or-single-surface"
        # Exit 0 when the focused Ghostty window shows exactly one terminal
        # surface (zoomed or single pane), 1 otherwise.
        __ghostty_zoomed_or_single_surface

    case "is-zoomed"
        # Exit 0 when a split is zoomed, 1 otherwise. See __ghostty_is_zoomed.
        __ghostty_is_zoomed

    case "is-floating-terminal"
        # Predicate: exit 0 when Ghostty's quick (floating) terminal is the
        # focused window, 1 otherwise. Mirrors iterm-preset is-floating-window-active.
        __ghostty_is_floating_terminal

    case "is-herdr-window"
        # Exit 0 when the front window is a lone herdr session (one tab, one pane,
        # not zoomed, title starts with "herdr"), 1 otherwise. See helper.
        __ghostty_is_herdr_window

    case "is-herdr-zoomed-or-single-surface"
        # Exit 0 when the focused window shows a single surface (zoomed split or
        # lone pane) running herdr, 1 otherwise. See helper.
        __ghostty_is_herdr_zoomed_or_single_surface

    case "is-multiplexer-app-zoomed-or-single-surface"
        # Exit 0 when the focused window shows a single surface (zoomed or lone
        # pane) running nvim or herdr, 1 otherwise. See helper.
        __ghostty_is_multiplexer_app_zoomed_or_single_surface

    case "new-split-with-fallback"
        # When the focused surface is a zoomed/single multiplexer pane (nvim or
        # herdr), it owns the split, so send its sequence: ctrl+space prefix, then
        # `v` (vertical) or `-` (horizontal). Otherwise make a native Ghostty
        # split. Defaults to horizontal like new-split.
        argparse 'v/vertical' 'h/horizontal' -- $argv
        or return 1
        if __ghostty_is_multiplexer_app_zoomed_or_single_surface
            osascript-preset send-keys ctrl space
            if set -q _flag_vertical
                osascript-preset send-keys v
            else
                osascript-preset send-keys minus
            end
        else if set -q _flag_vertical
            ghostty-preset new-split --vertical
        else
            ghostty-preset new-split --horizontal
        end

    case "new-tab-with-fallback"
        # In a lone herdr window, send herdr's new-tab sequence (ctrl+space prefix,
        # then shift+n). Anywhere else, make a native Ghostty tab.
        if __ghostty_is_herdr_window
            osascript-preset send-keys ctrl space
            osascript-preset send-keys shift n
        else
            osascript -e 'tell application id "com.mitchellh.ghostty" to new tab in front window'
        end

    case "reveal-floating-terminal"
        # Show the quick terminal if it isn't already the focused window. F17 is
        # bound globally to toggle_quick_terminal in the Ghostty config, so a
        # synthesized F17 toggles it. Guarded so this only ever reveals.
        ghostty-preset is-floating-terminal
        or osascript-preset send-keys f17

    case "hide-floating-terminal"
        # Hide the quick terminal if it is currently the focused window. Guarded
        # so this only ever hides. Mirrors iterm-preset hide-floating-terminal.
        ghostty-preset is-floating-terminal
        and osascript-preset send-keys f17

    case "focus-pane-with-fallback"
        set direction $argv[1]

        switch "$direction"
        case "left"
            set fallback_key h
        case "right"
            set fallback_key l
        case "down"
            set fallback_key j
        case "up"
            set fallback_key k
        case "*"
            return 1
        end

        # If a single surface (zoomed split or lone pane) running a multiplexer
        # (nvim or herdr) is shown, forward its pane-nav sequence: the ctrl+space
        # prefix, then ctrl+<hjkl>. Both bind this -- nvim's neoterminal maps
        # <c-space><c-h> -> <C-w>h (normal and terminal mode), and herdr uses the
        # same prefix -- so one sequence covers both. A non-multiplexer single
        # pane falls through to goto_split (a no-op if there's no split).
        if __ghostty_is_multiplexer_app_zoomed_or_single_surface
            osascript-preset send-keys ctrl space
            osascript-preset send-keys ctrl $fallback_key
            return
        end

        # Otherwise move between visible splits with Ghostty's own goto_split
        # keybind (cmd+alt+<arrow>, per the config). The keybind acts on the
        # *focused* surface, so it works even when a floating terminal overlays
        # another window -- unlike `perform action` on `front window`, which
        # targeted whatever regular window was in the background.
        osascript-preset send-keys cmd alt $direction

    case "nvim-tab-remote"
        function __exit_on_error -a message
            echo "Error: $message" >&2
            exit 1
        end

        # Fast path: already inside an nvim terminal.
        if set -q NVIM
            nvim --server "$NVIM" $argv
            or __exit_on_error "nvim --server exited with an error"
            return
        end

        # Under tmux the sibling-pane lookup is terminal-agnostic (tmux gives us
        # the tab's ttys), so reuse the socket path unchanged. This is the
        # dev-preset / devserver case and works identically in Ghostty.
        if test -n "$TMUX"
            set -l servers (nvim --headless -c 'lua for _, s in ipairs(vim.fn.serverlist({peer=true})) do print(s) end' -c 'qa!' 2>&1)
            or __exit_on_error "failed to list nvim servers"

            set tab_ttys (tmux list-panes -F '#{pane_tty}')
            or __exit_on_error "failed to get tab ttys"

            set -l found_server
            for server in $servers
                set -l nvim_pid (string match -r 'nvim\.(\d+)\.' "$server")[2]
                if test -n "$nvim_pid"
                    if test -d /proc/$nvim_pid/fd
                        set nvim_tty (readlink /proc/$nvim_pid/fd/0 2>/dev/null)
                    else
                        set nvim_tty (lsof -p "$nvim_pid" 2>/dev/null | string match -r '/dev/ttys\d+' | head -1)
                    end
                    if contains -- "$nvim_tty" $tab_ttys
                        set found_server "$server"
                        break
                    end
                end
            end

            if test -n "$found_server"
                nvim --server "$found_server" $argv
            else
                nvim $argv
            end
            or __exit_on_error "nvim exited with an error"
            return
        end

        # Bare Ghostty (no tmux): no tty means no server->pane correlation.
        # Drive the sibling nvim by keystrokes, located by its "nvim:" title
        # marker (set via titlestring in nvim config). If none is found, exec
        # nvim in this split (repurposing the split new-split created for us).
        argparse 'remote' -- $argv
        or return 1
        set -l file $argv[1]

        set -l drop_script '
on run argv
    set filePath to item 1 of argv
    tell application id "com.mitchellh.ghostty"
        try
            set target to (first terminal of selected tab of front window whose name starts with "nvim:")
        on error
            return "no"
        end try
        -- 1) force normal mode
        send key "\\" modifiers "control" to target
        send key "n" modifiers "control" to target
        -- 2) open cmdline with an explicit keypress
        send key ":" to target
        -- 3) paste the path literally (cmdline paste inserts literally)
        input text ("drop " & filePath) to target
        -- 4) execute
        send key "enter" to target
        return "yes"
    end tell
end run
'
        set -l found (osascript -e "$drop_script" "$file")

        if test "$found" != "yes"
            exec nvim $file
        end

    case "nvim-open-in-tab"
        set -l file (realpath "$(eval echo $argv[1])" 2>/dev/null)
        or begin
            echo "Error: file not found: $argv[1]" >&2
            exit 1
        end

        ghostty-preset nvim-tab-remote --remote "$file"

    case "iterate-windows"
        # Cycle Ghostty windows, skipping the devserver window (by id). Mirrors
        # iterm-preset iterate-windows: when Ghostty is already frontmost advance
        # to the next eligible window (wrapping); otherwise bring the most recent
        # eligible window forward. Ordered by id for predictable cycling.
        argparse 'except-window-id=' 'prev' -- $argv
        or return 1

        set -l except_id ""
        set -q _flag_except_window_id; and set except_id "$_flag_except_window_id"

        set -l want_prev 0
        set -q _flag_prev; and set want_prev 1

        osascript -e '
            on run argv
                set exceptId to item 1 of argv
                set wantPrev to (item 2 of argv) is "1"
                tell application id "com.mitchellh.ghostty"
                    set ids to {}
                    repeat with w in windows
                        set wid to id of w
                        if (wid as text) is not exceptId then set end of ids to wid
                    end repeat
                    if (count of ids) is 0 then
                        activate
                        return
                    end if
                    set recentId to item 1 of ids
                    set n to count of ids
                    repeat with i from 1 to n - 1
                        repeat with j from 1 to (n - i)
                            if (item j of ids) > (item (j + 1) of ids) then
                                set tmp to item j of ids
                                set item j of ids to item (j + 1) of ids
                                set item (j + 1) of ids to tmp
                            end if
                        end repeat
                    end repeat
                    set isFront to frontmost
                    set curId to missing value
                    try
                        set curId to id of front window
                    end try
                    set pos to 0
                    repeat with i from 1 to n
                        if (item i of ids) is curId then
                            set pos to i
                            exit repeat
                        end if
                    end repeat
                    if isFront and pos > 0 then
                        if wantPrev then
                            set targetPos to ((pos - 2 + n) mod n) + 1
                        else
                            set targetPos to (pos mod n) + 1
                        end if
                        set targetId to item targetPos of ids
                    else if pos > 0 then
                        set targetId to item pos of ids
                    else
                        set targetId to recentId
                    end if
                    activate
                    repeat with w in windows
                        if id of w is targetId then
                            activate window w
                            exit repeat
                        end if
                    end repeat
                end tell
            end run
        ' "$except_id" "$want_prev"

    case "*"
        return 1
    end
end

ghostty-preset $argv
