#!/usr/bin/env -S fish --no-config
set -x PATH /opt/homebrew/bin (status dirname) $PATH

# Thin shim over ghosttyPreset.lua (Hammerspoon). Each subcommand dispatches to
# the matching function there via a single `hs -c`, so there is ONE
# implementation shared by the CLI callers (term-preset, meta-preset,
# herdr-preset) and the Hammerspoon keybindings -- except the keybindings call
# the module directly (in-process) rather than through this shim, which is what
# removes the per-keystroke `hs -c` mach-port race.
#
# nvim-tab-remote / nvim-open-in-tab stay implemented here in fish: they depend
# on the caller's shell environment ($NVIM, $TMUX, cwd) and tools (nvim
# --server, tmux, lsof, /proc), none of which are reachable from inside
# Hammerspoon.

# Run a Lua boolean predicate and map it to this process's exit code, so the
# `case is-*` predicates keep working in `if` / `and` / `or`.
function __gp_bool
    test "$(hs -c "if $argv[1] then print('yes') end")" = yes
end

function ghostty-preset
    set preset $argv[1]
    set -e argv[1]

    switch "$preset"
    case "new-window"
        hs -c "require('ghosttyPreset').newWindow()"

    case "new-split"
        # -v/--vertical = left/right divider; default/-h = top/bottom divider.
        argparse 'v/vertical' 'h/horizontal' 'c/cmd=' -- $argv
        or return 1

        set -l vert (set -q _flag_vertical; and echo true; or echo false)

        if set -q _flag_cmd
            # Pass the command base64-encoded to sidestep three layers of quoting
            # (fish -> hs -c shell arg -> Lua string). ghosttyPreset decodes it.
            set -l enc (printf '%s' "$_flag_cmd" | base64 | tr -d '\n')
            hs -c "require('ghosttyPreset').newSplit({vertical=$vert, cmd=hs.base64.decode('$enc')})"
        else
            hs -c "require('ghosttyPreset').newSplit({vertical=$vert})"
        end

    case "new-tab"
        hs -c "require('ghosttyPreset').newTab()"

    case "is-zoomed-or-single-surface"
        __gp_bool "require('ghosttyPreset').isZoomedOrSingleSurface()"

    case "is-zoomed"
        __gp_bool "require('ghosttyPreset').isZoomed()"

    case "is-floating-terminal"
        __gp_bool "require('ghosttyPreset').isFloatingTerminal()"

    case "is-herdr-window"
        __gp_bool "require('ghosttyPreset').isHerdrWindow()"

    case "is-multiplexer-window"
        __gp_bool "require('ghosttyPreset').isMultiplexerWindow()"

    case "is-herdr-zoomed-or-single-surface"
        __gp_bool "require('ghosttyPreset').isHerdrZoomedOrSingleSurface()"

    case "is-multiplexer-app-zoomed-or-single-surface"
        __gp_bool "require('ghosttyPreset').isMultiplexerAppZoomedOrSingleSurface()"

    case "new-split-with-fallback"
        # Default (no flag) and -h -> horizontal; only -v -> vertical. Matches the
        # original fish semantics; the keybinding passes an explicit flag.
        argparse 'v/vertical' 'h/horizontal' -- $argv
        or return 1
        set -l horiz (set -q _flag_vertical; and echo false; or echo true)
        hs -c "require('ghosttyPreset').newSplitWithFallback($horiz)"

    case "new-tab-with-fallback"
        hs -c "require('ghosttyPreset').newTabWithFallback()"

    case "new-window-with-fallback"
        hs -c "require('ghosttyPreset').newWindowWithFallback()"

    case "focus-tab-with-fallback"
        hs -c "require('ghosttyPreset').focusTabWithFallback('$argv[1]')"

    case "close-pane-with-fallback"
        hs -c "require('ghosttyPreset').closePaneWithFallback()"

    case "focus-pane-with-fallback"
        hs -c "require('ghosttyPreset').focusPaneWithFallback('$argv[1]')"

    case "resize-pane-with-fallback"
        hs -c "require('ghosttyPreset').resizePaneWithFallback('$argv[1]')"

    case "reveal-floating-terminal"
        hs -c "require('ghosttyPreset').revealFloatingTerminal()"

    case "hide-floating-terminal"
        hs -c "require('ghosttyPreset').hideFloatingTerminal()"

    case "open-file-with-fallback"
        # Dispatch to ghosttyPreset.openFileWithFallback (herdr-aware). base64 the
        # path so it survives fish -> hs -c shell arg -> Lua without quoting.
        set -l enc (printf '%s' "$argv[1]" | base64 | tr -d '\n')
        hs -c "require('ghosttyPreset').openFileWithFallback(hs.base64.decode('$enc'))"

    case "execute-and-forget-herdr-command"
        # Run <cmd> in the herdr session showing in the focused window without
        # waiting for it (see ghosttyPreset.executeAndForgetHerdrCommand).
        # Returns as soon as the keystrokes are scheduled and says nothing about
        # whether the command ran, let alone what it printed --
        # execute-herdr-command below is the version that waits and answers.
        set -l cmd $argv[1]
        test -n "$cmd"; or begin
            echo "ghostty-preset execute-and-forget-herdr-command: no command given" >&2
            return 1
        end

        # base64 so the command survives fish -> hs -c shell arg -> Lua without
        # quoting, same as open-file-with-fallback above.
        set -l enc (printf '%s' "$cmd" | base64 | tr -d '\n')
        hs -c "require('ghosttyPreset').executeAndForgetHerdrCommand(hs.base64.decode('$enc'))"

    case "execute-herdr-command"
        # Run <cmd> in the herdr session showing in the focused window, wait for
        # it, print its output and exit with its status -- as if it had been run
        # locally.
        #
        #   execute-herdr-command [--timeout <seconds>] <cmd>
        #
        # The session may be a remote one (`herdr --remote <host>`), where its
        # socket is unreachable from this machine. What does reach it is herdr's
        # own run-command popup (ctrl+alt+shift+semicolon), and what comes back
        # is OSC 52: herdr intercepts the escape from a pane it renders and puts
        # the payload on the ATTACHED CLIENT's clipboard, i.e. ours. So the
        # clipboard carries the command in (pasting beats synthesizing a chord
        # per character, which made the keyboard klack on every letter) and the
        # answer out.
        #
        # <cmd> is wrapped so it reports itself: stdout+stderr and exit status
        # come back in one OSC 52 payload. The wrapper always exits 0 even when
        # <cmd> did not, so the popup always CLOSES -- run-command.sh holds a
        # popup open until a keypress on a non-zero exit, and a popup left
        # standing swallows the chords of every later run (herdr's popups are
        # session-modal), so one failure would otherwise poison the next.
        # Nothing is lost by that: the real status and output come back here.
        #
        # Getting the command there is execute-and-forget-herdr-command's job,
        # clipboard and all. Only the reply is ours -- and it lands ON the
        # clipboard, after that function has already put the old contents back,
        # so this saves and restores around the whole exchange as well.
        argparse 'timeout=' -- $argv
        or return 1

        set -l cmd $argv[1]
        test -n "$cmd"; or begin
            echo "ghostty-preset execute-herdr-command: no command given" >&2
            return 1
        end

        set -l timeout 5
        set -q _flag_timeout; and set timeout "$_flag_timeout"

        # A run owns the clipboard AND the popup from the first chord until its
        # reply lands, and neither can be shared: a second run overwrites the
        # wrapper the first one is about to paste, and its restore puts the old
        # clipboard back under the first one's feet. Two harpoon adds in quick
        # succession did exactly that. So they queue.
        set -l lock /tmp/ghostty-preset-herdr-exec.lock
        set -l acquired 0
        for i in (seq (math "round(($timeout + 10) * 20)"))
            if mkdir "$lock" 2>/dev/null
                set acquired 1
                echo $fish_pid > "$lock/pid"
                break
            end

            # Clear a lock whose owner is gone -- killed mid-run, say.
            set -l owner (cat "$lock/pid" 2>/dev/null)
            if test -n "$owner"; and not kill -0 "$owner" 2>/dev/null
                rm -rf "$lock"
            end

            sleep 0.05
        end
        test $acquired -eq 1; or begin
            echo "ghostty-preset execute-herdr-command: gave up waiting for another herdr command to finish" >&2
            return 1
        end

        # First line of the reply, so a clipboard that merely changed under us is
        # not mistaken for an answer. Per-run, so a reply that arrives after its
        # run gave up cannot be read as the next run's.
        set -l token "ghostty-preset:herdr-exec:$fish_pid-"(random)

        # bash: run-command.sh evals what it is handed. <cmd> is expected to be
        # bash-quoted already (jq's @sh is the easy way).
        set -l wrapper (string join '; ' \
            "__out=\$( { $cmd ; } 2>&1 )" \
            "__s=\$?" \
            "printf '\\033]52;c;%s\\007' \"\$(printf '%s\\n%s\\n%s' '$token' \"\$__s\" \"\$__out\" | base64 | tr -d '\\r\\n')\"" \
            "[ -n \"\$__out\" ] && printf '%s\\n' \"\$__out\"" \
            "true")

        set -l saved (pbpaste 2>/dev/null | string collect)

        # stdout discarded: everything this prints belongs to <cmd>, and `hs -c`
        # is free to echo whatever the Lua chunk evaluated to. stderr is kept.
        set -l drove 0
        ghostty-preset execute-and-forget-herdr-command "$wrapper" >/dev/null; or set drove 1

        # 50ms ticks. Nothing arrives at all if the popup never opened, hence the
        # cap -- leaving our own wrapper on the clipboard is worse than giving up.
        set -l reply
        if test $drove -eq 0
            for i in (seq (math "round($timeout * 20)"))
                sleep 0.05

                set -l parts (string split -m 2 \n -- (pbpaste 2>/dev/null | string collect))
                if test (count $parts) -ge 2; and test "$parts[1]" = "$token"
                    set reply $parts
                    break
                end
            end
        end

        if test -n "$saved"
            printf '%s' "$saved" | pbcopy
        else
            printf '' | pbcopy
        end

        rm -rf "$lock"

        if test $drove -ne 0
            echo "ghostty-preset execute-herdr-command: could not drive the herdr run-command popup" >&2
            return 1
        end

        test (count $reply) -ge 2; or begin
            echo "ghostty-preset execute-herdr-command: no reply within {$timeout}s -- is the focused window running herdr?" >&2
            return 1
        end

        test (count $reply) -ge 3; and printf '%s\n' "$reply[3]"

        string match -qr '^\d+$' -- "$reply[2]"; or return 1
        return "$reply[2]"

    case "iterate-windows"
        argparse 'except-window-id=' 'prev' -- $argv
        or return 1
        set -l except ""
        set -q _flag_except_window_id; and set except "$_flag_except_window_id"
        set -l prev (set -q _flag_prev; and echo true; or echo false)
        hs -c "require('ghosttyPreset').iterateWindows({exceptId='$except', prev=$prev})"

    case "nvim-tab-remote"
        function __exit_on_error -a message
            echo "Error: $message" >&2
            exit 1
        end

        # Fast path: already inside an nvim terminal.
        if set -q NVIM
            nvim --server "$NVIM" $argv
            or __exit_on_error "nvim --server exited with an error"
            return
        end

        # Under tmux the sibling-pane lookup is terminal-agnostic (tmux gives us
        # the tab's ttys), so reuse the socket path unchanged. This is the
        # dev-preset / devserver case and works identically in Ghostty.
        if test -n "$TMUX"
            set -l servers (nvim --headless -c 'lua for _, s in ipairs(vim.fn.serverlist({peer=true})) do print(s) end' -c 'qa!' 2>&1)
            or __exit_on_error "failed to list nvim servers"

            set tab_ttys (tmux list-panes -F '#{pane_tty}')
            or __exit_on_error "failed to get tab ttys"

            set -l found_server
            for server in $servers
                set -l nvim_pid (string match -r 'nvim\.(\d+)\.' "$server")[2]
                if test -n "$nvim_pid"
                    if test -d /proc/$nvim_pid/fd
                        set nvim_tty (readlink /proc/$nvim_pid/fd/0 2>/dev/null)
                    else
                        set nvim_tty (lsof -p "$nvim_pid" 2>/dev/null | string match -r '/dev/ttys\d+' | head -1)
                    end
                    if contains -- "$nvim_tty" $tab_ttys
                        set found_server "$server"
                        break
                    end
                end
            end

            if test -n "$found_server"
                nvim --server "$found_server" $argv
            else
                nvim $argv
            end
            or __exit_on_error "nvim exited with an error"
            return
        end

        # Bare Ghostty (no tmux): no tty means no server->pane correlation.
        # Drive the sibling nvim by keystrokes, located by its "nvim:" title
        # marker (set via titlestring in nvim config). If none is found, exec
        # nvim in this split (repurposing the split new-split created for us).
        argparse 'remote' -- $argv
        or return 1
        set -l file $argv[1]

        set -l drop_script '
on run argv
    set filePath to item 1 of argv
    tell application id "com.mitchellh.ghostty"
        try
            set target to (first terminal of selected tab of front window whose name starts with "nvim:")
        on error
            return "no"
        end try
        -- 1) force normal mode
        send key "\\" modifiers "control" to target
        send key "n" modifiers "control" to target
        -- 2) open cmdline with an explicit keypress
        send key ":" to target
        -- 3) paste the path literally (cmdline paste inserts literally)
        input text ("drop " & filePath) to target
        -- 4) execute
        send key "enter" to target
        return "yes"
    end tell
end run
'
        set -l found (osascript -e "$drop_script" "$file")

        if test "$found" != "yes"
            exec nvim $file
        end

    case "nvim-open-in-tab"
        set -l file (realpath "$(eval echo $argv[1])" 2>/dev/null)
        or begin
            echo "Error: file not found: $argv[1]" >&2
            exit 1
        end

        ghostty-preset nvim-tab-remote --remote "$file"

    case "*"
        return 1
    end
end

ghostty-preset $argv
