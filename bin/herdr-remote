#!/usr/bin/env python3

"""Request remote Herdr actions on the attached Mac via OSC 52.

    herdr-remote attach [terminal] [--tab | --split [right|down]]
                        [--pane <id>] [--space <name>] [--name <title>]
                        [--machine <name>] [--no-focus] [--dry-run]

    herdr-remote run [--tab | --split [right|down]] [--pane <id>]
                     [--space <name>] [--name <title>] [--folder <dir>]
                     [--no-focus] [--dry-run] -- <cmd> [args...]

Herdr forwards OSC 52 clipboard writes from a pane it renders to the attached
Mac's clipboard, where Hammerspoon (herdrRelay.lua + herdrAction.lua) consumes
the framed record, restores the clipboard, and drives herdr-app:

  - attach:    zero confirmation; opens a new tab, split, or workspace attached
               to an existing remote hc terminal.
  - run:       mandatory confirmation dialog on the Mac showing the exact
               command and target before running any local command.
"""

import argparse
import base64
import json
import os
import re
import subprocess
import sys
import socket
import tempfile
import copy
import uuid
import time
import importlib.machinery
import importlib.util
from pathlib import Path

# Must match stow_modules/main/dot-hammerspoon/herdrAction.lua.
VERSION = "HERDR_ACTION_V1"
NAMESPACE = "4d8e9a1c6f3b4e2da91f7c508b2e641a"
RS = "\x1e"
US = "\x1f"
OSC52 = "\033]52;c;%s\007"

# OSC 52 wire budget (16384 bytes total; 8 bytes wrapper -> 12282 raw bytes).
MAX_RECORD_BYTES = 12282
MAX_ENCODED_LEN = 16384
MAX_ARGV_LEN = 64
MAX_ARG_BYTES = 2048

TOKEN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
PANE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,511}$")
CORE_ID_RE = re.compile(r"^[0-9a-fA-F]{1,64}$")
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")


def die(message, code=2):
    sys.stderr.write("herdr-remote: %s\n" % message)
    sys.exit(code)


def valid_label(value):
    return isinstance(value, str) and 1 <= len(value) <= 128 and not CONTROL_RE.search(value)


def valid_folder(value):
    if not isinstance(value, str) or not (1 <= len(value) <= 512):
        return False
    if CONTROL_RE.search(value) or ".." in value:
        return False
    return value == "~" or value.startswith("/") or value.startswith("~/")


def hc_core_id():
    """Hex id of the herdr-core instance hosting this terminal, if any."""
    if not (
        os.environ.get("HC_TERMINAL_ID")
        or os.environ.get("HC_TERMINAL_SOCKET")
        or os.environ.get("HC_SOCKET")
    ):
        return None
    session = os.environ.get("HC_SESSION") or "default"
    if not re.fullmatch(r"[A-Za-z0-9._-]+", session):
        return None
    state_home = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    core_json = os.path.join(state_home, "herdr-core", session, "core.json")
    try:
        with open(core_json, "r", encoding="utf-8") as fh:
            m = re.search(r'"id"\s*:\s*"([0-9a-fA-F]+)"', fh.read())
            if m and CORE_ID_RE.fullmatch(m.group(1)):
                return m.group(1).lower()
    except OSError:
        pass
    return None


def resolve_tty():
    """Find a writable controlling terminal for OSC 52 output."""
    try:
        os.close(os.open("/dev/tty", os.O_WRONLY))
        return "/dev/tty"
    except OSError:
        pass

    pid = os.getpid()
    for _ in range(8):
        try:
            out = subprocess.run(
                ["ps", "-o", "ppid=,tty=", "-p", str(pid)],
                capture_output=True,
                text=True,
                timeout=5,
            ).stdout.split()
        except (OSError, subprocess.SubprocessError):
            break
        if len(out) < 1 or not out[0].isdigit() or int(out[0]) <= 1:
            break
        pid = int(out[0])
        name = out[1] if len(out) > 1 else ""
        if name in ("", "?", "??", "-"):
            continue
        path = name if name.startswith("/dev/") else "/dev/" + name
        if os.access(path, os.W_OK):
            return path

    hc_term = os.environ.get("HC_TERMINAL_ID")
    if hc_term:
        try:
            hc_out = subprocess.run(
                ["hc", "get", hc_term, "--json"],
                capture_output=True,
                text=True,
                timeout=5,
            ).stdout
            m = re.search(r'"pid"\s*:\s*(\d+)', hc_out)
            if m:
                tty_name = subprocess.run(
                    ["ps", "-o", "tty=", "-p", m.group(1)],
                    capture_output=True,
                    text=True,
                    timeout=5,
                ).stdout.strip()
                if tty_name not in ("", "?", "??", "-"):
                    path = tty_name if tty_name.startswith("/dev/") else "/dev/" + tty_name
                    if os.access(path, os.W_OK):
                        return path
        except (OSError, subprocess.SubprocessError):
            pass

    user = os.environ.get("USER")
    if user:
        try:
            ps_out = subprocess.run(
                ["ps", "-u", user, "-o", "tty=,comm="],
                capture_output=True,
                text=True,
                timeout=5,
            ).stdout
            for line in ps_out.splitlines():
                parts = line.split()
                if len(parts) >= 2 and parts[1] == "herdr" and parts[0] not in ("?", "??", "-"):
                    path = parts[0] if parts[0].startswith("/dev/") else "/dev/" + parts[0]
                    if os.access(path, os.W_OK):
                        return path
        except (OSError, subprocess.SubprocessError):
            pass

    return None


def encode_record(payload):
    raw_json = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    encoded = base64.b64encode(raw_json).decode("ascii")
    if len(encoded) > MAX_ENCODED_LEN:
        die("encoded payload exceeds %d bytes" % MAX_ENCODED_LEN)
    record = "%s%s:%s:%s%s" % (RS, VERSION, NAMESPACE, encoded, US)
    if len(record.encode("utf-8")) > MAX_RECORD_BYTES:
        die("framed record exceeds %d-byte OSC 52 limit" % MAX_RECORD_BYTES)
    return record


def emit_osc52(record, tty_path=None):
    where = tty_path or resolve_tty()
    if where is None:
        die("no terminal to write the OSC 52 action escape to", code=1)
    wire = base64.b64encode(record.encode("utf-8")).decode("ascii")
    try:
        with open(where, "w", encoding="utf-8") as fh:
            fh.write(OSC52 % wire)
            fh.flush()
    except OSError as exc:
        die("cannot write to %s (%s)" % (where, exc), code=1)


def add_layout_args(parser):
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--tab", action="store_true", help="open in a new tab (default)")
    mode.add_argument(
        "--split",
        nargs="?",
        const="right",
        choices=("right", "down"),
        metavar="DIR",
        help="split a pane (right or down; default: right)",
    )
    parser.add_argument("--pane", help="anchor pane ID for --split")
    parser.add_argument("--space", help="target workspace name or ID (reuse first match or create)")
    parser.add_argument("--name", help="tab title")
    parser.add_argument("--no-focus", action="store_true", help="do not focus the new space/tab")
    parser.add_argument("--dry-run", action="store_true", help="print JSON payload instead of emitting OSC 52")


def apply_layout_payload(args, payload):
    if args.split is not None:
        payload["mode"] = "split"
        payload["direction"] = args.split
    else:
        payload["mode"] = "tab"

    if args.pane is not None:
        if not PANE_RE.fullmatch(args.pane):
            die("invalid pane ID: %r" % args.pane)
        payload["pane"] = args.pane

    if args.space is not None:
        if not valid_label(args.space):
            die("invalid workspace name/ID: %r" % args.space)
        payload["space"] = args.space

    if args.name is not None:
        if not valid_label(args.name):
            die("invalid tab name: %r" % args.name)
        payload["name"] = args.name

    if args.no_focus:
        payload["focus"] = False


def build_attach_payload(args):
    raw_target = args.terminal or os.environ.get("HC_TERMINAL_ID")
    if not raw_target:
        die("missing terminal ID (pass <terminal> or set $HC_TERMINAL_ID)")

    machine = args.machine
    terminal = raw_target
    if "/" in raw_target:
        parts = raw_target.split("/", 1)
        if machine and machine != parts[0]:
            die("conflicting --machine %r and target %r" % (machine, raw_target))
        machine, terminal = parts[0], parts[1]

    if not TOKEN_RE.fullmatch(terminal):
        die("invalid terminal ID: %r" % terminal)

    payload = {
        "action": "attach",
        "terminal": terminal,
    }

    if machine is not None:
        if not TOKEN_RE.fullmatch(machine):
            die("invalid machine name: %r" % machine)
        payload["machine"] = machine
    else:
        core_id = hc_core_id()
        if not core_id:
            die("cannot determine remote machine (pass --machine <name> or run inside hc)")
        payload["core_id"] = core_id

    apply_layout_payload(args, payload)
    return payload


def build_run_payload(args):
    if not args.space:
        die("local run requires --space <workspace>")
    if args.split is not None and (args.folder is not None or args.no_focus):
        die("--split does not support --folder or --no-focus")
    argv = list(args.cmd or [])
    if argv and argv[0] == "--":
        argv = argv[1:]
    if not argv:
        die("missing command (use: herdr-remote run [options] -- <cmd> [args...])")
    if len(argv) > MAX_ARGV_LEN:
        die("too many arguments (max %d)" % MAX_ARGV_LEN)
    for item in argv:
        if len(item.encode("utf-8")) > MAX_ARG_BYTES or "\x00" in item:
            die("invalid command argument")

    payload = {
        "action": "local.run",
        "argv": argv,
    }

    if args.folder is not None:
        if not valid_folder(args.folder):
            die("invalid folder path: %r" % args.folder)
        payload["folder"] = args.folder

    apply_layout_payload(args, payload)
    return payload


MAX_REPLY_BYTES = 1048576


def deliver_reply(path, nonce):
    """Internal receiver: stdin is JSON, never shell input or terminal keys."""
    data = sys.stdin.buffer.read(MAX_REPLY_BYTES + 1)
    if len(data) > MAX_REPLY_BYTES:
        die("reply exceeds byte limit", code=1)
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(5)
        client.connect(path)
        client.sendall(nonce.encode("ascii") + b"\n" + data)
    return 0


def request_listing(args):
    core = hc_core_id()
    if not core:
        die("listing requires an hc terminal with a core ID")
    with tempfile.TemporaryDirectory(prefix="herdr-remote-") as directory:
        path = os.path.join(directory, "reply.sock")
        nonce = os.urandom(16).hex()
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
            server.bind(path)
            server.listen(1)
            server.settimeout(20)
            deadline = time.monotonic() + 20
            payload = {"action": "list", "kind": args.kind,
                       "reply": {"core_id": core, "socket": path, "nonce": nonce,
                                 "bin": os.path.realpath(__file__)}}
            emit_osc52(encode_record(payload))
            try:
                connection, _ = server.accept()
                with connection:
                    connection.settimeout(5)
                    chunks, size = [], 0
                    while True:
                        remaining = deadline - time.monotonic()
                        if remaining <= 0:
                            die("listing reply deadline exceeded", code=1)
                        connection.settimeout(min(5, remaining))
                        chunk = connection.recv(65536)
                        if not chunk:
                            break
                        size += len(chunk)
                        if size > MAX_REPLY_BYTES + 33:
                            die("reply exceeds byte limit", code=1)
                        chunks.append(chunk)
                header, _, body = b"".join(chunks).partition(b"\n")
                if header.decode("ascii") != nonce:
                    die("reply nonce mismatch", code=1)
                result = json.loads(body)
                sys.stdout.write(json.dumps(result, ensure_ascii=True) + "\n")
                return 1 if isinstance(result, dict) and "error" in result else 0
            except (OSError, ValueError) as exc:
                die("listing reply failed: %s" % exc, code=1)


def move_document(document, pane, terminal, space, tab=None, name=None):
    """Pure layout update: preserve terminal/pane identity and unrelated nodes."""
    doc = copy.deepcopy(document)
    spaces = doc.get("spaces", [])
    destinations = [sp for sp in spaces if sp.get("id") == space]
    if len(destinations) != 1:
        raise ValueError("destination workspace missing or ambiguous")
    destination = destinations[0]
    matches = []

    def scan(node, sp, tb):
        if not isinstance(node, dict):
            return
        if node.get("id") == pane and node.get("type") == "block":
            matches.append((sp, tb, node))
        for child in node.get("children", []):
            scan(child, sp, tb)

    for sp in spaces:
        for tb in sp.get("tabs", []):
            scan(tb.get("root"), sp, tb)
    if len(matches) != 1 or (matches[0][2].get("content") or {}).get("terminal") != terminal:
        raise ValueError("source pane missing, ambiguous, or terminal changed")
    source_space, source_tab, moved = matches[0]
    if tab is not None:
        targets = [tb for tb in destination.get("tabs", []) if tb.get("id") == tab]
        if len(targets) != 1:
            raise ValueError("destination tab missing or ambiguous")
        target = targets[0]
        if target is source_tab:
            raise ValueError("pane is already in destination tab")
        if not isinstance(target.get("root"), dict):
            raise ValueError("destination tab has no layout root")
    else:
        target = {"id": "tb" + uuid.uuid4().hex, "name": name or "moved pane"}

    def detach(node):
        if node is moved:
            return None
        if "children" in node:
            node["children"] = [kept for child in node["children"] if (kept := detach(child)) is not None]
            if not node["children"]:
                return None
        return node

    remaining = detach(source_tab["root"])
    if remaining is None:
        source_space["tabs"].remove(source_tab)
    else:
        source_tab["root"] = remaining
    moved.pop("size", None)
    if tab is None:
        target["root"] = {"id": "r" + uuid.uuid4().hex, "type": "row", "children": [moved]}
        destination.setdefault("tabs", []).append(target)
    else:
        target["root"] = {"id": "r" + uuid.uuid4().hex, "type": "row",
                          "children": [target["root"], moved]}
    if source_space is not destination and not source_space["tabs"]:
        spaces.remove(source_space)
    return doc, target["id"]


def load_core_adapter():
    # Reuse the existing, tested hc socket transport, not a shell invocation.
    loader = importlib.machinery.SourceFileLoader(
        "herdr_remote_core", str(Path(__file__).resolve().with_name("hc-preset")))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    adapter = importlib.util.module_from_spec(spec)
    loader.exec_module(adapter)
    return adapter


def move_on_mac(pane, space, tab, name, expected_terminal):
    adapter = load_core_adapter()
    layout = adapter.require_reply(adapter.herdr_app_rpc({"ls": True}), "pane move inspect")
    sources = [(sp, tb, term) for sp in layout.get("spaces", [])
               for tb in sp.get("tabs", []) for term in tb.get("terminals", [])
               if term.get("pane") == pane]
    destinations = [sp for sp in layout.get("spaces", []) if sp.get("id") == space]
    if len(sources) != 1 or len(destinations) != 1:
        raise ValueError("source or destination missing or ambiguous")
    source, _, term = sources[0]
    destination = destinations[0]
    if term.get("terminal") != expected_terminal:
        raise ValueError("source terminal changed after confirmation")
    machine = source.get("machine") or ""
    if (destination.get("machine") or "") != machine:
        raise ValueError("cross-machine pane moves are unsupported")
    prefix = machine + "/" if machine else ""

    def bare(value):
        if prefix:
            if not value.startswith(prefix):
                raise ValueError("ID does not belong to source machine")
            return value[len(prefix):]
        if "/" in value:
            raise ValueError("unexpected remote ID in local workspace")
        return value

    params = {"name": "herdr-app"}
    if machine:
        params["on"] = machine
    result = adapter.require_reply(adapter.hc_rpc("doc.get", params), "pane move doc.get").get("result", {})
    if not isinstance(result.get("value"), dict) or result.get("version") is None:
        raise ValueError("missing versioned layout document")
    changed, destination_tab = move_document(result["value"], bare(pane), bare(expected_terminal),
                                            bare(space), bare(tab) if tab else None, name)
    adapter.require_reply(adapter.hc_rpc("doc.set", {**params, "version": result["version"],
                                                    "value": changed}), "pane move doc.set")
    try:
        adapter.require_reply(adapter.hc_rpc("terminal.label", {
            "terminal": expected_terminal,
            "labels": {"herdr.space": bare(space), "herdr.tab": destination_tab},
        }), "pane move terminal.label")
    except Exception as exc:
        raise ValueError("layout moved but label update failed; inspect before retrying: %s" % exc) from exc
    sys.stdout.write(json.dumps({"pane": pane, "terminal": expected_terminal,
                                 "space": space, "tab": prefix + destination_tab}) + "\n")
    return 0


def build_parser():
    parser = argparse.ArgumentParser(
        prog="herdr-remote",
        description="Trigger remote Herdr actions on the attached Mac via OSC 52.",
    )
    sub = parser.add_subparsers(dest="subcommand", required=True)

    p_attach = sub.add_parser(
        "attach",
        help="attach a new tab/split/workspace on the Mac to an existing remote hc terminal (no confirmation)",
    )
    p_attach.add_argument(
        "terminal",
        nargs="?",
        help="terminal ID (e.g. t5j or devserver/t5j; defaults to $HC_TERMINAL_ID)",
    )
    p_attach.add_argument("--machine", help="remote machine alias on the Mac (auto-detected from hc core_id if omitted)")
    add_layout_args(p_attach)

    p_run = sub.add_parser(
        "run",
        help="run a local command on the Mac in Herdr (always prompts for confirmation)",
    )
    p_run.add_argument("--folder", help="local working directory on the Mac")
    add_layout_args(p_run)
    p_run.add_argument("cmd", nargs=argparse.REMAINDER, help="command and arguments (prefix with --)")

    for name in ("focus", "select-space", "select-tab", "zoom"):
        p = sub.add_parser(name, help="change an existing Herdr target")
        p.add_argument("target", help="exact machine-qualified terminal, workspace, tab, or pane ID")
        p.add_argument("--dry-run", action="store_true")

    p_move = sub.add_parser("move", help="move an existing pane; confirms the local helper on the Mac")
    p_move.add_argument("pane")
    p_move.add_argument("--space", required=True, help="exact destination workspace ID, on the same machine")
    p_move.add_argument("--tab", help="exact existing destination tab ID; omitted creates a tab")
    p_move.add_argument("--name", help="new tab name")
    p_move.add_argument("--dry-run", action="store_true")

    p_list = sub.add_parser("list", help="print bounded JSON from the Mac")
    p_list.add_argument("kind", choices=("agents", "workspaces", "tabs"))

    return parser


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "--deliver-reply":
        if len(argv) != 3 or not re.fullmatch(r"[0-9a-f]{32}", argv[2]):
            die("invalid reply delivery")
        try:
            return deliver_reply(argv[1], argv[2])
        except OSError as exc:
            die("reply delivery failed: %s" % exc, code=1)
    if argv and argv[0] == "--move-on-mac":
        if len(argv) != 6 or any(not PANE_RE.fullmatch(v) for v in (argv[1], argv[2], argv[5])):
            die("invalid internal move request")
        if argv[3] != "-" and not PANE_RE.fullmatch(argv[3]):
            die("invalid destination tab")
        if not valid_label(argv[4]):
            die("invalid tab name")
        try:
            return move_on_mac(argv[1], argv[2], None if argv[3] == "-" else argv[3], argv[4], argv[5])
        except Exception as exc:
            die("pane move failed: %s" % exc, code=1)
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.subcommand == "list":
        return request_listing(args)
    if args.subcommand == "move":
        if any(not PANE_RE.fullmatch(v) for v in (args.pane, args.space)):
            die("invalid pane or workspace ID")
        if args.tab is not None and not PANE_RE.fullmatch(args.tab):
            die("invalid tab ID")
        if args.name is not None and not valid_label(args.name):
            die("invalid tab name")
        payload = {"action": "pane.move", "pane": args.pane, "space": args.space}
        if args.tab is not None:
            payload["tab"] = args.tab
        if args.name is not None:
            payload["name"] = args.name
    elif args.subcommand == "attach":
        payload = build_attach_payload(args)
    elif args.subcommand == "run":
        payload = build_run_payload(args)
    else:
        if not PANE_RE.fullmatch(args.target):
            die("invalid target ID")
        actions = {"focus": "focus", "select-space": "space.select",
                   "select-tab": "tab.select", "zoom": "pane.zoom"}
        payload = {"action": actions[args.subcommand], "target": args.target}

    record = encode_record(payload)
    if args.dry_run:
        sys.stdout.write(json.dumps(payload, separators=(",", ":")) + "\n")
        return 0

    emit_osc52(record)
    return 0


if __name__ == "__main__":
    sys.exit(main())
