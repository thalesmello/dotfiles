#!/usr/bin/env -S fish --no-config
set -x PATH /opt/homebrew/bin (status dirname) $PATH
set -g CHROME_PRESET_DB "$HOME/.local/share/chrome-preset/apps.db"

function app-db-init
    mkdir -p (path dirname "$CHROME_PRESET_DB")
    sqlite3 "$CHROME_PRESET_DB" "
        CREATE TABLE IF NOT EXISTS apps (
            app_name TEXT PRIMARY KEY,
            window_id TEXT NOT NULL,
            chrome_info TEXT NOT NULL
        );
    "
end

function app-db-query
    app-db-init
    sqlite3 "$CHROME_PRESET_DB" $argv
end

function app-db-exec
    app-db-init
    sqlite3 "$CHROME_PRESET_DB" $argv
end

function sq-escape
    string replace -a "'" "''" $argv
end

# The invariant substring used to re-identify a preset app's window: the URL
# with its query/hash parameters, scheme, optional "www." prefix, trailing
# conversation UUID path segment, and trailing slashes removed. Which
# conversation a window is showing lives in those parameters or path segments,
# so a relaunched window still contains this substring even though its exact
# URL has moved on, and launch URLs without "www." (https://internalfb.com/...)
# still match Chrome's canonical "https://www.internalfb.com/..." URL:
#   https://muse.ai/?chat=abc                                -> muse.ai
#   https://internalfb.com/calendar                          -> internalfb.com/calendar
#   https://agentcloud.internalmeta.com/6bf8b410-1c95-...    -> agentcloud.internalmeta.com
#   https://www.internalfb.com/intern/bunny?metamate3        -> agentcloud.internalmeta.com
function url-invariant
    set -l raw "$argv[1]"
    test -n "$raw"; or return 0

    # Bunnylol launch aliases carry the target app in the query string and
    # redirect to a different host/path once opened. Map known preset aliases
    # to their destination invariant before stripping query parameters.
    if string match -qr 'intern/bunny\?metamate3(\b|$)' -- "$raw"
        echo "agentcloud.internalmeta.com"
        return 0
    else if string match -qr 'intern/bunny\?metamate(\b|%20|\+|$)' -- "$raw"
        echo "internalfb.com/metamate"
        return 0
    else if string match -qr '^https?://(www\.)?(wa\.me|web\.whatsapp\.com|api\.whatsapp\.com)(\b|/|$)' -- "$raw"
        echo "web.whatsapp.com"
        return 0
    end

    string replace -r '[?#].*$' '' -- "$raw" \
        | string replace -r '^https?://(www\.)?' '' \
        | string replace -r '/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(/.*)?$' '' \
        | string replace -r '/+$' ''
    return 0
end

# Echo the yabai window id of a preset app whose stored id no longer exists,
# adopting the matching pre-existing window into the DB, or return 1 when no
# live window matches. This covers a Chrome restart (e.g. for an update):
# Chrome relaunches its app-mode windows, but under new yabai window ids, so
# the DB id goes stale and a bare lookup would spawn a duplicate window.
#
# Candidates are single-tab Chrome windows whose normalized URL contains the
# invariant substring of the app's URL -- both the URL the caller asked for
# and the one captured in the DB when the app was created, since launch URLs
# can be aliases that redirect elsewhere. A candidate only counts once it is
# correlated with a yabai *app-mode* Chrome window (browser windows carry
# "- Google Chrome -" in their title, app windows don't -- see close-apps),
# so an ordinary browser tab on the same site is never adopted as the preset
# app.
function rediscover-app-window
    argparse profile= -- $argv
    or return 1

    set -l appname $argv[1]
    set -l url $argv[2]

    # Without a running Chrome there is nothing to rediscover -- and JXA
    # references to it would launch it. Callers fall back to create-app.
    test -n "$(get-main-chrome-pid)"; or return 1
    test -n "$url"; or return 1

    set -l needles
    set -l stored_info (app-db-query "SELECT chrome_info FROM apps WHERE app_name = '$(sq-escape $appname)';" | string collect)
    set -l stored_url (echo "$stored_info" | jq -r '.url // empty' 2>/dev/null)
    # Prefer the stored post-redirect URL first (when it isn't still an
    # un-redirected bunny alias), then the caller's launch URL, then both
    # MetaMate domains when launched through a bunny metamate alias.
    set -l candidate_urls
    if test -n "$stored_url"; and not string match -qr 'intern/bunny\?' -- "$stored_url"
        set -a candidate_urls "$stored_url"
    end
    set -a candidate_urls "$url"
    if test -n "$stored_url"
        set -a candidate_urls "$stored_url"
    end
    if string match -qr 'intern/bunny\?metamate' -- "$url"
        set -a candidate_urls "https://agentcloud.internalmeta.com/" "https://www.internalfb.com/metamate"
    end
    if string match -qr '^https?://(www\.)?(wa\.me|web\.whatsapp\.com|api\.whatsapp\.com)(\b|/|$)' -- "$url"
        set -a candidate_urls "https://web.whatsapp.com/" "https://api.whatsapp.com/"
    end
    for candidate_url in $candidate_urls
        set -l needle (url-invariant "$candidate_url")
        test -n "$needle"; or continue
        contains -- "$needle" $needles; or set -a needles "$needle"
    end
    test (count $needles) -gt 0; or return 1

    set -l tabs_json (chrome-preset list-tabs-json | string collect)
    test -n "$tabs_json"; or return 1

    set -l profile_name ""
    if test -n "$_flag_profile"
        set profile_name (chrome-preset get-profile-name "$_flag_profile" 2>/dev/null)
    end

    # Fetch all Chrome windows from yabai once. Filter to real AXWindow /
    # AXStandardWindow entries with non-empty titles so Chrome's hidden
    # AXHelpTag tooltip surfaces (title == "") are never mistaken for app
    # windows. Default role/subrole to AXWindow/AXStandardWindow so minimal
    # test fixtures with only {id, title} still work.
    set -l all_yabai_json (yabai-preset list-windows --all --app '^Google Chrome$' 2>/dev/null \
        | jq -s -c '[.[] | select(((.role // "AXWindow") == "AXWindow")
                                  and ((.subrole // "AXStandardWindow") == "AXStandardWindow")
                                  and ((.title // "") != ""))]' 2>/dev/null)
    test -n "$all_yabai_json"; or return 1
    test "$all_yabai_json" != "[]"; or return 1

    set -l claimed_json (app-db-query "SELECT window_id FROM apps WHERE app_name != '$(sq-escape $appname)';" \
        | jq -R . | jq -sc 'map(select(. != ""))')
    set -l needles_json (printf '%s\n' $needles | jq -R . | jq -sc 'map(select(. != ""))')

    # Correlate Chrome tabs with yabai app-mode windows in a single jq pass:
    # - Keep only single-tab Chrome windows ((.tabCount // 1) == 1), since
    #   Chrome --app windows never have a tab strip or multiple tabs.
    # - Normalize URLs the same way url-invariant does (strip query/hash,
    #   scheme, leading www., and trailing slashes) so https://internalfb.com/...
    #   matches https://www.internalfb.com/...
    # - After a Chrome restart, restored background app windows often have
    #   w.tabs.title()[0] == "" until focused, while yabai's window title is
    #   already "<window.name()> - <profile>" or "<url host> - <profile>"
    #   (e.g. "web.whatsapp.com - Thales (Personal)"). Match against tab
    #   title, windowTitle (w.name()), middle-ellipsis windowTitle, and URL
    #   host, plus window bounds when available.
    set -l match_plan (echo "$tabs_json" | jq -c \
        --argjson needles "$needles_json" \
        --argjson yabai_wins "$all_yabai_json" \
        --argjson claimed "$claimed_json" \
        --arg profile "$profile_name" '
        def norm:
            sub("[?#].*$"; "")
            | sub("^https?://(www[.])?"; "")
            | sub("/+$"; "");
        def url_host:
            sub("^https?://"; "")
            | sub("[/?#].*$"; "")
            | ascii_downcase;
        def is_browser_title($t):
            ($t | test(" - Google Chrome( - .*)?$"));
        def strip_memory($t):
            ($t | sub(" - High memory usage - [0-9.]+ [KMGT]?B$"; ""));
        def app_base_title($t):
            if ($profile != "" and ($t | endswith(" - " + $profile))) then
                strip_memory($t | rtrimstr(" - " + $profile))
            else
                strip_memory($t | sub(" - [^-]+$"; ""))
            end;
        def browser_base_title($t):
            strip_memory($t | sub(" - Google Chrome( - .*)?$"; ""));

        ([$yabai_wins[] | select(is_browser_title(.title)) | browser_base_title(.title)]) as $browser_titles
        | ([$yabai_wins[] | select(is_browser_title(.title) | not)
            | . + {
                base_title: app_base_title(.title),
                profile_ok: ($profile == "" or (.title | endswith(" - " + $profile))),
                is_claimed: ((.id | tostring) as $id | ($claimed | index($id)) != null)
            }]) as $all_app_wins
        | (if ($profile != "" and ($all_app_wins | any(.profile_ok))) then
              [$all_app_wins[] | select(.profile_ok)]
           else
              $all_app_wins
           end) as $app_wins
        | if ($app_wins | length) == 0 then
              {picked: null, candidates: []}
          else
              ([ .tabs[]?
                 | select(((.tabCount // 1) == 1) and .url != null and .url != "")
                 | (.url | norm) as $u_norm
                 | ([$needles[] | select(. as $n | $u_norm | contains($n))]) as $matched
                 | select(($matched | length) > 0)
                 | (.title // "") as $tt
                 | (.windowTitle // "") as $wt
                 | (if $tt != "" then $tt else $wt end) as $eff_t
                 | (.url | url_host) as $host
                 | ($host | ltrimstr("www.")) as $host_nowww
                 | (($eff_t != "")
                    and ($browser_titles | index($eff_t) != null)
                    and ([$app_wins[] | select(.base_title == $eff_t or .title == $eff_t)] | length == 0)) as $only_browser
                 | {
                     id,
                     url,
                     title: $tt,
                     windowTitle: $wt,
                     eff_title: $eff_t,
                     host: $host,
                     host_nowww: $host_nowww,
                     windowId,
                     minimized: (.minimized // false),
                     bounds: (.bounds // null),
                     only_browser: $only_browser,
                     needle_idx: ([$matched[] | . as $m | $needles | index($m)] | min),
                     tier: (if ($matched | index($u_norm)) != null then 0 else 1 end),
                     specificity: ($matched | map(length) | max),
                     stripped_len: ($u_norm | length)
                   }
               ] | sort_by([(if .only_browser then 1 else 0 end), .needle_idx, .tier, -.specificity, .stripped_len])) as $cands
              | (
                  [ $cands[]
                    | select(.only_browser | not)
                    | . as $c
                    | (
                        [ $app_wins[]
                          | . as $yw
                          | (if ($c.bounds != null and $yw.frame != null
                                 and (($c.minimized // false) == ($yw."is-minimized" // false))
                                 and ((($c.bounds.x - $yw.frame.x) | fabs) <= 10)
                                 and ((($c.bounds.y - $yw.frame.y) | fabs) <= 40)
                                 and ((($c.bounds.width - $yw.frame.w) | fabs) <= 10)
                                 and ((($c.bounds.height - $yw.frame.h) | fabs) <= 40))
                             then 0 else 1 end) as $bounds_rank
                          | (if ($c.title != "" and ($yw.base_title == $c.title or $yw.title == $c.title)) then 1
                             elif ($c.windowTitle != "" and ($yw.base_title == $c.windowTitle or $yw.title == $c.windowTitle)) then 2
                             elif ($c.title != "" and ($yw.base_title | startswith($c.title))) then 3
                             elif ($c.windowTitle != "" and ($yw.base_title | startswith($c.windowTitle))) then 4
                             elif ($c.windowTitle != "" and ($c.windowTitle | contains("…")) and (
                                   ($c.windowTitle | split("…")) as $parts
                                   | ($parts | length) == 2
                                     and ($yw.base_title | startswith($parts[0]))
                                     and ($yw.base_title | endswith($parts[1])))) then 5
                             elif ($c.title == "" and $c.host != "" and (
                                   ($yw.base_title | ascii_downcase) as $bt
                                   | $bt == $c.host or $bt == $c.host_nowww
                                     or ($bt | startswith($c.host)) or ($bt | startswith($c.host_nowww)))) then 6
                             elif ($c.title != "" and ($yw.base_title | contains($c.title))) then 7
                             elif ($c.windowTitle != "" and ($yw.base_title | contains($c.windowTitle))) then 8
                             else null end) as $match_tier
                          | select($match_tier != null)
                          | {yw: $yw, match_tier: $match_tier, claim_rank: (if $yw.is_claimed then 1 else 0 end), bounds_rank: $bounds_rank}
                        ]
                        | sort_by([.match_tier, .claim_rank, .bounds_rank])
                        | first
                      ) as $best_yw
                    | select($best_yw != null)
                    | {candidate: $c, window_id: $best_yw.yw.id}
                  ] | first
                ) as $direct_pick
              | if $direct_pick != null then
                    {picked: $direct_pick, candidates: $cands, app_wins: $app_wins}
                else
                    # Fallback when the tab has no usable title yet: if exactly
                    # one unclaimed app-mode window exists in this profile and
                    # we have a non-browser candidate with an empty title, adopt
                    # it without stealing a titled window from another app.
                    ([$app_wins[] | select(.is_claimed | not)]) as $unclaimed
                    | ([$cands[] | select((.only_browser | not) and .eff_title == "")] | first) as $blank_cand
                    | if ($blank_cand != null and ($unclaimed | length) == 1) then
                          {picked: {candidate: $blank_cand, window_id: $unclaimed[0].id}, candidates: $cands, app_wins: $app_wins}
                      else
                          {picked: null, candidates: [ $cands[] | select(.only_browser | not) ], app_wins: $app_wins}
                      end
                end
          end')
    test -n "$match_plan"; or return 1

    set -l picked (echo "$match_plan" | jq -r '.picked.window_id // empty')
    set -l picked_candidate (echo "$match_plan" | jq -c '.picked.candidate // empty')

    if test -z "$picked"
        # Last resort: iterate through the non-browser candidates, focus each
        # Chrome window, and read back which yabai window surfaced, accepting
        # it only if that window is one of the app-mode windows above.
        set -l fallback_candidates (echo "$match_plan" | jq -c '.candidates[]?')
        test (count $fallback_candidates) -gt 0; or return 1

        for cand in $fallback_candidates
            set -l chrome_window_id (echo "$cand" | jq -r '.windowId // empty')
            test -n "$chrome_window_id"; or continue
            chrome-preset focus-window "$chrome_window_id" >/dev/null 2>&1; or continue
            set -l focused_id (yabai-preset get-focused-window-id 2>/dev/null)
            test -n "$focused_id"; or continue
            if echo "$match_plan" | jq -e --argjson id "$focused_id" 'any(.app_wins[]?; .id == $id)' >/dev/null 2>&1
                set picked "$focused_id"
                set picked_candidate "$cand"
                break
            end
        end
    end

    test -n "$picked"; or return 1

    # Record the adoption, with chrome_info rebuilt from the matched tab in
    # the shape chrome-cli info produced at create time ({id = tab id,
    # windowId = Chrome window id}), so open-in-app / enforce-url callers
    # that re-read it keep working against the relaunched window.
    set -l chrome_info (echo "$picked_candidate" | jq -c '{id: (.id | tostring), title: (if (.title // "") != "" then .title else (.windowTitle // "") end), url, windowId: (.windowId | tostring)}')
    app-db-exec "INSERT OR REPLACE INTO apps (app_name, window_id, chrome_info) VALUES ('$(sq-escape $appname)', '$(sq-escape $picked)', '$(sq-escape $chrome_info)');"
    echo "$picked"
end

# Echo the app's live yabai window id: the stored one when it still exists,
# otherwise a rediscovered pre-existing window (see rediscover-app-window),
# otherwise return 1 so the caller launches a fresh window.
function resolve-app-window
    argparse profile= -- $argv
    or return 1

    set -l appname $argv[1]
    set -l url $argv[2]

    set -l window (app-db-query "SELECT window_id FROM apps WHERE app_name = '$(sq-escape $appname)';")
    if test -n "$window"; and yabai-preset get-window-info "$window" >/dev/null
        echo "$window"
        return 0
    end
    rediscover-app-window --profile="$_flag_profile" "$appname" "$url"
end

function is-browser-window
    set title (yabai-preset query-windows --window | jq -r '.title')
    or return 1
    string match -q -- '*- Google Chrome -*' "$title"
end

function is-app-window
    set title (yabai-preset query-windows --window | jq -r '.title')
    or return 1
    not string match -q -- '*- Google Chrome -*' "$title"
end

# Browser windows (BrowserNativeWidgetWindow) have "- Google Chrome -" in the title.
# Native app windows (NativeWidgetMacNSWindow) don't.
function get-profile-regex
    argparse 'browser-only' 'app-only' -- $argv
    or return 1

    set escaped "$(string escape --style=regex "$argv[1]")\$"

    if set -q _flag_browser_only
        echo "- Google Chrome - $escaped"
    else if set -q _flag_app_only
        echo "^(?!.*- Google Chrome -).*$escaped"
    else
        echo "$escaped"
    end
end

function get-main-chrome-pid
    pgrep -f '/Applications/Google Chrome\.app/Contents/MacOS/Google Chrome' | head -1
end

function chrome-trigger-menu-bar
    set -l chrome_pid (get-main-chrome-pid)
    set -l pid_args
    if test -n "$chrome_pid"
        set pid_args --pid "$chrome_pid"
    end
    osascript-preset trigger-menu-bar --app "Google Chrome" $pid_args $argv
end

function chrome-process-ref
    set -l chrome_pid (get-main-chrome-pid)
    if test -n "$chrome_pid"
        echo "(first process whose unix id is $chrome_pid)"
    else
        echo 'process "Google Chrome"'
    end
end

function chrome-preset
    set preset $argv[1]
    set -e argv[1]

    switch "$preset"
    case "list-tabs-json"
        # Fast replacement for `chrome-cli list tabs` / `chrome-cli list links`.
        # chrome-cli reads each tab's id, url and title with a separate Apple
        # Event, so listing many tabs costs hundreds of round-trips (seconds).
        # JXA array-property calls (`w.tabs.id()` etc.) return every value for a
        # whole window in a single Apple Event, keeping this to a handful of
        # round-trips regardless of tab count. Output matches chrome-cli's JSON
        # shape for the fields callers consume: {tabs: [{id, url, title, windowId}]},
        # plus window-level metadata (windowTitle, tabCount, minimized, bounds)
        # used by rediscover-app-window to correlate single-tab app windows even
        # when a restored tab's DOM title is still empty after a Chrome restart.
        osascript -l JavaScript -e '
            const chrome = Application("Google Chrome");
            const wins = chrome.windows;
            let wids, wnames, wmins, wbounds;
            try { wids = wins.id(); } catch (e) { wids = []; }
            try { wnames = wins.name(); } catch (e) { wnames = []; }
            try { wmins = wins.minimized(); } catch (e) { wmins = []; }
            try { wbounds = wins.bounds(); } catch (e) { wbounds = []; }
            const tabs = [];
            for (let i = 0; i < wids.length; i++) {
                const w = wins[i];
                let ids, urls, titles;
                try {
                    ids = w.tabs.id();
                    urls = w.tabs.url();
                    titles = w.tabs.title();
                } catch (e) { continue; }
                const tabCount = ids.length;
                const windowTitle = (wnames && wnames[i]) || "";
                const minimized = !!(wmins && wmins[i]);
                const bounds = (wbounds && wbounds[i]) || null;
                for (let j = 0; j < tabCount; j++) {
                    tabs.push({
                        id: ids[j],
                        url: urls[j] || "",
                        title: titles[j] || "",
                        windowId: wids[i],
                        windowTitle: windowTitle,
                        tabCount: tabCount,
                        minimized: minimized,
                        bounds: bounds,
                    });
                }
            }
            JSON.stringify({tabs: tabs});
        '
    case "active-tab-json"
        # The active tab of a Chrome window, as {id, url, title, windowId}. Used
        # by hammerspoon's focushistory to turn a window-title change into a tab
        # identity (see focushistory.lua).
        #
        # With --match-title <ax window title>, picks the window whose active tab
        # title prefixes that string, i.e. the macOS window the caller actually
        # means. Chrome's AX title is "<tab title> - Google Chrome - <profile>",
        # the same correlation focus-url uses below. WITHOUT the flag we can only
        # take chrome.windows[0], and Chrome's window order counts app-mode
        # windows (chrome-preset create-app: Calendar, Keep, Metamate...), so on a
        # machine with a few of those open windows[0] is usually NOT the browser
        # window that just got focused. Emitting {} on no match is deliberate:
        # a caller keying history off the tab id must not be handed the wrong tab.
        #
        # Same bulk-JXA trick as list-tabs-json above: `w.tabs.id()` is one Apple
        # Event for the whole window, where per-tab `.id()` costs ~500ms on a
        # busy window.
        #
        # Overlaps `env OUTPUT_FORMAT=json chrome-cli info` (what yabai-harpoon
        # uses to capture a chrome_tab pin, yabai-harpoon.fish:231) -- same four
        # fields. Kept separate deliberately: this one never touches
        # `chrome.activeTab`, which is what makes `chrome-cli info` die with
        # "-[SBProxyByCode activeTab]: object has not been added to a container
        # yet" (a hard ObjC crash, not an error exit) when it can't reach a front
        # window. Indexing windows/tabs explicitly degrades to `{}` instead,
        # which matters here because focushistory probes on every tab switch.
        #
        # Guarded on the process because a JXA `Application("Google Chrome")`
        # reference LAUNCHES Chrome if it isn't running, and a focus-history
        # probe must never do that. Exit 1 = no Chrome; exit 0 with `{}` = Chrome
        # is up but has no scriptable window.
        argparse match-title= -- $argv
        or return 1

        test -n "$(get-main-chrome-pid)"
        or return 1

        # Passed through the environment rather than interpolated: window titles
        # contain quotes, backslashes and emoji.
        env CHROME_MATCH_TITLE="$_flag_match_title" osascript -l JavaScript -e '
            ObjC.import("Foundation");
            const chrome = Application("Google Chrome");
            const env = $.NSProcessInfo.processInfo.environment;
            const want = ObjC.unwrap(env.objectForKey("CHROME_MATCH_TITLE")) || "";
            let out = {};
            try {
                const wins = chrome.windows;
                const wids = wins.id();
                let pick = -1, idx = 0;
                for (let i = 0; i < wids.length; i++) {
                    // Without a hint, fall back to Chrome window order.
                    if (!want) { pick = 0; idx = wins[0].activeTabIndex(); break; }
                    let t;
                    try {
                        const at = wins[i].activeTabIndex();
                        t = wins[i].tabs.title()[at - 1] || "";
                        if (t && want.indexOf(t) === 0) { pick = i; idx = at; break; }
                    } catch (e) { continue; }
                }
                if (pick >= 0) {
                    const w = wins[pick];
                    const ids = w.tabs.id();
                    const urls = w.tabs.url();
                    const titles = w.tabs.title();
                    if (idx >= 1 && idx <= ids.length) {
                        out = {
                            id: ids[idx - 1],
                            url: urls[idx - 1] || "",
                            title: titles[idx - 1] || "",
                            windowId: wids[pick],
                        };
                    }
                }
            } catch (e) { out = {}; }
            JSON.stringify(out);
        '
    case "focus-tab"
        # Activate a Chrome tab and bring its window to front in a single
        # osascript call. Returns non-zero if the tab/window wasn't found
        # (e.g. tab was closed), which callers use to trigger pin refresh.
        set tab_id $argv[1]
        set -e argv[1]
        set chrome_window_id $argv[1]
        set -e argv[1]

        set result (osascript -l JavaScript -e "
            const chrome = Application('Google Chrome');
            // Fetch all window ids, then (for the match) all tab ids, in ONE Apple
            // Event each and match in memory. Calling .id() per window/tab is one
            // round-trip each and costs ~500ms for a busy window (e.g. 32 tabs);
            // the bulk form is ~15ms.
            const winIds = chrome.windows.id();
            let found = false;
            for (let wi = 0; wi < winIds.length; wi++) {
                if (winIds[wi] == $chrome_window_id) {
                    const w = chrome.windows[wi];
                    const tabIds = w.tabs.id();
                    for (let i = 0; i < tabIds.length; i++) {
                        if (tabIds[i] == $tab_id) {
                            w.activeTabIndex = i + 1;
                            w.index = 1;
                            chrome.activate();
                            found = true;
                            break;
                        }
                    }
                    break;
                }
            }
            found ? 'ok' : 'not_found';
        ")

        test "$result" = "ok"
        or return 1

    case "focus-window"
        set window_id $argv[1]
        set -e argv[1]

        osascript -e "tell application \"Google Chrome\"
            set index of (first window whose id is $window_id) to 1
            activate
        end tell"
        or return 1
    case "focus-url"
        argparse profile= -- $argv
        or return 1

        set regex $argv[1]
        set -e argv[1]

        # When --profile is given, scope the search to that profile's browser
        # windows. Chrome scripting can't read a window's profile directly, but
        # yabai sees the profile suffix in the window title (e.g. "… - Google
        # Chrome - Thales (Personal)") — the same signal focus-profile-window
        # uses. We hand those titles to the JXA below, which keeps only windows
        # whose active-tab title correlates with one of them. With no profile (or
        # no matching window) the search falls back to every window.
        set -l titles
        if test -n "$_flag_profile"
            set -l profile_name (chrome-preset get-profile-name "$_flag_profile")
            set -l profile_regex (get-profile-regex --browser-only "$profile_name")
            set titles (yabai-preset list-windows --regex "$profile_regex" | jq -r '.title')
        end

        # Find the first tab whose URL matches $regex and focus it — locate,
        # select and activate in a SINGLE JXA round-trip. Only window names and
        # tab URLs are fetched (one Apple Event each) and we stop at the first
        # match, so this avoids list-tabs-json's extra id/title fetches, the jq
        # subprocess, the separate focus-window osascript, and the slow chrome-cli
        # activate process the previous implementation chained together.
        #
        # Inputs are passed via the environment (not string-interpolated) to avoid
        # quoting/injection issues. Note the pattern is matched by JavaScript's
        # RegExp rather than jq/Oniguruma; simple URL patterns behave identically.
        set result (env CHROME_FOCUS_REGEX="$regex" CHROME_FOCUS_TITLES=(string join \n -- $titles) osascript -l JavaScript -e '
            ObjC.import("Foundation");
            const chrome = Application("Google Chrome");
            const env = $.NSProcessInfo.processInfo.environment;
            const re = new RegExp(ObjC.unwrap(env.objectForKey("CHROME_FOCUS_REGEX")));
            const rawTitles = ObjC.unwrap(env.objectForKey("CHROME_FOCUS_TITLES")) || "";
            const titles = rawTitles ? rawTitles.split("\n").filter(t => t.length) : null;
            const wins = chrome.windows;
            let count;
            try { count = wins.length; } catch (e) { count = 0; }
            let found = false;
            for (let wi = 0; wi < count && !found; wi++) {
                const w = wins[wi];

                // Restrict to the profile windows. Chrome exposes no profile, and
                // window.name() is middle-truncated (with an ellipsis) and lacks the
                // profile suffix, so it cannot be matched. Instead correlate on the
                // full active-tab title, which appears verbatim inside the yabai
                // window title (e.g. "<tab title> - Google Chrome - Thales (Personal)").
                if (titles) {
                    let tabTitles, activeIdx;
                    try { tabTitles = w.tabs.title(); activeIdx = w.activeTabIndex(); } catch (e) { continue; }
                    const activeTitle = tabTitles[activeIdx - 1];
                    if (!(activeTitle && titles.some(t => t.indexOf(activeTitle) !== -1))) {
                        continue;
                    }
                }

                let urls;
                try { urls = w.tabs.url(); } catch (e) { continue; }
                for (let i = 0; i < urls.length; i++) {
                    if (urls[i] && re.test(urls[i])) {
                        w.activeTabIndex = i + 1;
                        w.index = 1;
                        chrome.activate();
                        found = true;
                        break;
                    }
                }
            }
            found ? "ok" : "not_found";
        ')

        test "$result" = "ok"
        or return 1
    case "check-url"
        set regex $argv[1]
        set -e argv[1]

        set json (chrome-preset list-tabs-json | string collect)
        jq -ern --arg regex "$regex" --argjson json "$json" '
        $json
        | first(.tabs.[] | select(.url | test($regex)))
        | .id'
        or return 1

    case "focus-or-open-url"
        argparse fallback= profile= label= -- $argv
        or return 1

        set regex $argv[1]
        set -e argv[1]

        if test -n "$_flag_fallback"
            set url "$_flag_fallback"
        else
            set url "$regex"
            set regex (string escape --style=regex "$regex")
        end

        if test -n "$_flag_label"
            display-message "Open $_flag_label"
        end

        chrome-preset focus-url --profile="$_flag_profile" "$regex"
        or chrome-preset open-url --newtab --profile="$_flag_profile" "$url"
        or return 1
    case "check-or-open-url"
        argparse fallback= profile= label= -- $argv
        or return 1

        set regex $argv[1]
        set -e argv[1]

        if test -n "$_flag_fallback"
            set url "$_flag_fallback"
        else
            set url "$regex"
            set regex (string escape --style=regex "$regex")
        end

        if test -n "$_flag_label"
            display-message "Check $_flag_label"
        end

        chrome-preset check-url "$regex"
        or chrome-preset open-url --newtab --profile="$_flag_profile" "$url"
        or return 1
    case "check-tab-id"
        set tab_id $argv[1]
        set -e argv[1]

        set json (env OUTPUT_FORMAT=json chrome-cli info -t "$tab_id" | string collect)

        test -z "$json"; and return 1

        echo "$json"

    case "get-window-title"
        osascript -e '
            tell application "Google Chrome"
                return properties of front window
            end tell
        '

    case "get-profile-name"
        set profile $argv[1]
        set -e argv[1]

        jq --arg profile "$profile" -r '.profile.info_cache[$profile] | "\(.gaia_given_name) (\((.enterprise_label | select(. != "")) // .name))"' <"$HOME/Library/Application Support/Google/Chrome/Local State"

    case focus-profile
        set profile $argv[1]
        set -e argv[1]

        set profile_name (chrome-preset get-profile-name "$profile")
        and osascript-preset show-or-hide-app --only-show "Google Chrome"
        and chrome-trigger-menu-bar "Profiles;$profile_name"

    case "open-url"
        argparse profile= label= newtab newtabright -- $argv
        or return 1

        set url $argv[1]
        set -e argv[1]

        if test -n "$_flag_label"
            display-message "Open $_flag_label"
        end

        if not string match -qr '^https?://' "$url"
            set url "https://$url"
        end

        set app (hs-preset get-active-app)

        if test "$app" != "Google Chrome"; or set -q _flag_newtab; or is-app-window
            test -n "$_flag_profile"; and begin
                set profile_name (chrome-preset get-profile-name "$_flag_profile")
                chrome-preset focus-profile-window "$profile_name"
            end
            chrome-preset new-tab "$url"
        else if set -q _flag_newtabright
            test -n "$_flag_profile"; and chrome-preset focus-profile "$_flag_profile"

            chrome-preset new-tab --right "$url"
        else if test -z "$_flag_profile"
            env OUTPUT_FORMAT=json chrome-cli info | jq -r '.id' | read --line tab_id
            chrome-cli open "$url" $extra_args -t "$tab_id"
        else
            set profile_name (chrome-preset get-profile-name "$_flag_profile")
            set -l process_ref (chrome-process-ref)
            osascript -e "
                tell application \"System Events\"
                    tell $process_ref
                        set windowTitles to name of every window
                    end tell
                end tell

                if (count of windowTitles) > 0 and item 1 of windowTitles contains \"$profile_name\" then
                    tell application \"Google Chrome\"
                        set URL of active tab of front window to \"$url\"
                    end tell
                else
                    set matchIndex to 0
                    repeat with i from 1 to count of windowTitles
                        if item i of windowTitles contains \"$profile_name\" then
                            set matchIndex to i
                            exit repeat
                        end if
                    end repeat

                    if matchIndex > 0 then
                        tell application \"Google Chrome\"
                            set targetWin to window matchIndex
                            set index of targetWin to 1
                            tell targetWin
                                make new tab with properties {URL:\"$url\"}
                            end tell
                        end tell
                    end if
                end if
            "
        end

    case "new-tab"
        argparse right -- $argv
        or return 1

        set url ""
        if test (count $argv) -ge 1
            set url $argv[1]
            set -e argv[1]
        end

        # Chrome's AppleScript dictionary has no notion of tab groups, so
        # `make new tab at after tab (active tab index)` always drops the tab
        # OUTSIDE whatever group the active tab belongs to. Chrome's own
        # new-tab-to-the-right command does inherit the group, but it is only
        # reachable through the UI: the Tab menu, labelled "New Tab Below"
        # under vertical tabs and "New Tab to the Right" otherwise. Drive that
        # menu item and point the tab it creates at the URL; fall back to the
        # positional insert below if the menu isn't there (e.g. Chrome isn't
        # frontmost, so the item is unavailable).
        if set -q _flag_right
            set -l set_url ""
            if test -n "$url"
                set set_url "set URL of newTab to \"$url\""
            end

            set -l prev (osascript -e '
                tell application "Google Chrome"
                    tell front window
                        return id of active tab
                    end tell
                end tell')

            if test -n "$prev"
                for item in "New Tab Below" "New Tab to the Right"
                    chrome-trigger-menu-bar "Tab;$item" >/dev/null 2>&1
                    or continue

                    # The click returns before Chrome has opened the tab, so
                    # poll until the active tab is no longer the one we
                    # started from.
                    set -l tab_id (osascript -e "
                        tell application \"Google Chrome\"
                            repeat 40 times
                                tell front window
                                    set newTab to active tab
                                    if id of newTab is not $prev then
                                        $set_url
                                        return id of newTab
                                    end if
                                end tell
                                delay 0.05
                            end repeat
                            return \"\"
                        end tell")

                    test -n "$tab_id"
                    or continue

                    echo "$tab_id"
                    return 0
                end
            end
        end

        set pos ""
        if set -q _flag_right
            set pos " at after tab (active tab index)"
        end

        set props ""
        if test -n "$url"
            set props " with properties {URL:\"$url\"}"
        end

        set cmd "
            tell application \"Google Chrome\"
                tell front window
                    set newTab to make new tab$pos$props
                    return id of newTab
                end tell
            end tell"

        osascript -e "$cmd"

    case "close-tabs-with-url"
        set regex $argv[1]
        set -e argv[1]

        set tabs (chrome-preset list-tabs-json \
        | jq -er --arg regex "$regex" '
        .tabs.[]
        | select(.url | test($regex))
        | debug(.)
        | .id')
        and for tab_id in $tabs
            chrome-cli close -t "$tab_id"
        end
        or return 1

    case "click-selector"
        set selector $argv[1]
        set -e argv[1]

        chrome-cli execute "document.querySelector($(string escape "$selector")).click()"
    case "create-app"
        argparse profile= -- $argv

        set appname $argv[1]
        set -e argv[1]

        set url $argv[1]
        set -e argv[1]

        yabai -m signal --add \
            event=window_created \
            app='^Google Chrome$' \
            label="store_chrome_preset_app_info" \
            action="fish -c 'chrome-preset store-preset-app --window-id \"\$YABAI_WINDOW_ID\" \"$appname\"'; yabai -m signal --remove store_chrome_preset_app_info"

        open -na 'Google Chrome' --args --profile-directory="$_flag_profile" --app="$url"

    case store-preset-app
        argparse window-id= -- $argv

        set appname $argv[1]
        set -e argv[1]

        set window_id "$_flag_window_id"

        set chrome_info (env OUTPUT_FORMAT=json chrome-cli info | string collect)
        app-db-exec "INSERT OR REPLACE INTO apps (app_name, window_id, chrome_info) VALUES ('$(sq-escape $appname)', '$window_id', '$(sq-escape $chrome_info)');"

        # window_created fires while the new tab is still loading (and before
        # redirect aliases like intern/bunny?... reach their destination URL).
        # Poll briefly in the background so chrome_info records the settled
        # destination URL and title for future rediscovery.
        set -l tab_id (echo "$chrome_info" | jq -r '.id // empty' 2>/dev/null)
        if test -n "$tab_id"; and echo "$chrome_info" | jq -e '.loading == true or ((.url // "") | test("intern/bunny|^$|^about:blank"))' >/dev/null 2>&1
            fish -c "
                for i in (seq 25)
                    sleep 0.2
                    set info (env OUTPUT_FORMAT=json chrome-cli info -t '$tab_id' 2>/dev/null | string collect)
                    test -n \"\$info\"; or break
                    if echo \"\$info\" | jq -e '.loading == false and ((.url // \"\") | test(\"intern/bunny|^\\\$|^about:blank\") | not)' >/dev/null 2>&1
                        sqlite3 '$CHROME_PRESET_DB' \"UPDATE apps SET chrome_info = '\$(string replace -a \"'\" \"''\" -- \$info)' WHERE app_name = '$(sq-escape $appname)' AND window_id = '$(sq-escape $window_id)';\"
                        break
                    end
                end
            " >/dev/null 2>&1 &
            disown
        end
    case "open-in-app"
        argparse profile= if-open -- $argv
        or return 1

        set appname $argv[1]
        set -e argv[1]

        set url $argv[1]
        set -e argv[1]

        if set window (resolve-app-window --profile="$_flag_profile" "$appname" "$url")
            set chrome_info (app-db-query "SELECT chrome_info FROM apps WHERE app_name = '$(sq-escape $appname)';")
            set -l tab_id (jq -nr --argjson app "$chrome_info" '$app.id')

            # WhatsApp Web intercepts clicks on `<a>` elements in a capture-phase
            # window listener and opens `wa.me` / `web.whatsapp.com/send` links
            # in-place without reloading the page. Try dispatching a synthetic
            # anchor click first; if JavaScript from Apple Events is disabled or
            # the app is not ready, fall back to navigating with `chrome-cli open`.
            set -l opened_in_place 0
            if string match -qr '^https?://(www\.)?(wa\.me|web\.whatsapp\.com|api\.whatsapp\.com)(\b|/|$)' -- "$url"
                set -l js_url (jq -rn --arg u "$url" '$u | @json')
                set -l js_result (chrome-cli execute "(() => { if (location.hostname !== 'web.whatsapp.com') return 'fallback'; let handled = false; const a = document.createElement('a'); a.href = $js_url; a.addEventListener('click', e => { handled = e.defaultPrevented; e.preventDefault(); }); (document.body || document.documentElement).appendChild(a); a.click(); a.remove(); return handled ? 'handled' : 'fallback'; })()" -t "$tab_id" 2>/dev/null | string trim)
                if test "$js_result" = "handled"
                    set opened_in_place 1
                end
            end

            if test "$opened_in_place" -eq 0
                chrome-cli open "$url" -t "$tab_id"
            end
            wm-preset focus-window-id "$window"
        else if set -q _flag_if_open
            return 1
        else
            chrome-preset create-app --profile="$_flag_profile" "$appname" "$url"
        end
    case "get-app-window-id"
        set appname $argv[1]
        set -e argv[1]

        set window_id (app-db-query "SELECT window_id FROM apps WHERE app_name = '$(sq-escape $appname)';")
        test -n "$window_id"; or return 1
        echo "$window_id"
    case "url-invariant"
        # The parameter-stripped form of a URL used as the rediscovery
        # search substring (see url-invariant above).
        url-invariant $argv[1]
    case "find-app-window"
        # Rediscover a pre-existing preset window for <appname> whose URL
        # matches <url>'s invariant substring, adopt it into the DB, and
        # print its (new) yabai window id. Returns 1 when nothing matches,
        # leaving window creation to the caller.
        argparse profile= -- $argv
        or return 1

        set appname $argv[1]
        set -e argv[1]

        rediscover-app-window --profile="$_flag_profile" "$appname" $argv[1]
    case "resolve-app-window"
        # The stored window id when it still exists, else a rediscovered
        # one (find-app-window); returns 1 when the app has no live window.
        argparse profile= -- $argv
        or return 1

        set appname $argv[1]
        set -e argv[1]

        resolve-app-window --profile="$_flag_profile" "$appname" $argv[1]
    case "close-apps"
        if test -z "$(get-main-chrome-pid)"
            echo 0
            return 0
        end

        # "Chrome preset app" here means a Chrome app-mode/headerless window,
        # not only a window currently present in apps.db. Reuse the same title
        # shape as is-app-window/get-profile-regex: Chrome browser windows include
        # " - Google Chrome - ..." in their title; app-mode windows do not.
        set app_title_regex (get-profile-regex --app-only "")
        set window_ids (yabai-preset list-windows --all --app '^Google Chrome$' --regex "$app_title_regex" \
            | jq -r 'select(((.role // "AXWindow") == "AXWindow")
                            and ((.subrole // "AXStandardWindow") == "AXStandardWindow")
                            and ((.title // "") != "")
                            and (.title | test(" - Google Chrome$") | not)) | .id')
        or return 1

        if test (count $window_ids) -eq 0
            echo 0
            return 0
        end

        set closed
        for window_id in $window_ids
            # Close by yabai window id instead of focusing and sending Cmd+W: a
            # failed focus can still exit 0 for off-space Chrome app windows,
            # which would send Cmd+W to the currently focused browser tab.
            yabai -m window "$window_id" --close >/dev/null 2>&1
            or continue

            set -a closed "$window_id"
            app-db-exec "DELETE FROM apps WHERE window_id = '$(sq-escape $window_id)';"
        end

        echo (count $closed)
    case "focus-or-create-app"
        argparse profile= enforce-url -- $argv

        set appname $argv[1]
        set -e argv[1]

        set url $argv[1]
        set -e argv[1]

        if set window (resolve-app-window --profile="$_flag_profile" "$appname" "$url")
            if set -q _flag_enforce_url
                set chrome_info (app-db-query "SELECT chrome_info FROM apps WHERE app_name = '$(sq-escape $appname)';")
                set tab_id (jq -nr --argjson app "$chrome_info" '$app.id')
                set current_url (env OUTPUT_FORMAT=json chrome-cli info -t "$tab_id" | jq -r '.url')
                if test "$current_url" != "$url"
                    chrome-cli open "$url" -t "$tab_id"
                end
            end

            wm-preset focus-window-id "$window"
        else
            chrome-preset create-app --profile="$_flag_profile" "$appname" "$url"
        end
    case "alternate-app"
        argparse profile= minimize=? hide=? app= -- $argv

        set app "$_flag_app"

        set fallback

        set -l app_url ""
        test (count $argv) -ge 1; and set app_url $argv[1]

        # Read the focused window id before resolving: rediscovery's last
        # resort focuses the candidate window, which would otherwise make a
        # window the user is already on look unfocused (and vice versa).
        # hs sees the floating terminal, which yabai doesn't.
        set active_id (hs-preset get-floatingterm-or-focused-window-id)

        # Resolve rather than reading the DB directly, so a window relaunched
        # under a new id by a Chrome restart is re-adopted here too --
        # including for the toggle-off below, not just the focus path.
        set app_window_id (resolve-app-window --profile="$_flag_profile" "$app" "$app_url")

        if test -n "$app_window_id"

            # Collapse the floating terminal in the background so it doesn't
            # hover in front of the app we focus next.
            term-preset hide-floating-terminal &
            disown
            if test "$active_id" = "$app_window_id"

                if set -q _flag_hide
                    hs-preset send-keys cmd h
                else if set -q _flag_minimize
                    yabai-preset minimize
                else
                    wm-preset focus-window-id recent
                end
            else
                set fallback 1
            end
        else
            set fallback 1
        end


        if test -n "$fallback"
            chrome-preset focus-or-create-app --profile "$_flag_profile" "$app" $argv
        end
    case "get-app-name"
        argparse window-id= -- $argv

        set appname (app-db-query "SELECT app_name FROM apps WHERE window_id = '$_flag_window_id';")
        test -n "$appname"; or return 1
        echo "$appname"
    case "focus-profile-window"
        set profile_name $argv[1]
        set -e argv[1]
        set regex (get-profile-regex --browser-only "$profile_name")

        set current_display (yabai-preset get-focused-display)
        test -n "$current_display"; or set current_display 0

        echo "chrome-preset focus-profile-window: profile='$profile_name' regex='$regex' current_display=$current_display" >&2

        set windows (yabai-preset list-windows --include-minimized --regex "$regex" | jq -s -r --argjson current_display "$current_display" '
            sort_by([
                (if ."is-minimized" then 1 else 0 end),
                (if .display == $current_display then 0 else 1 end)
            ])
            | .[].id')
        or return 1

        if test (count $windows) -gt 0
            echo "chrome-preset focus-profile-window: fast path via yabai focus-window-id $windows[1] (visible/minimized matches: $windows)" >&2
            yabai-preset focus-window-id "$windows[1]"
        else
            echo "chrome-preset focus-profile-window: slow fallback via Chrome Profiles menu (no visible window matched)" >&2
            osascript-preset show-or-hide-app --only-show "Google Chrome"
            and chrome-trigger-menu-bar "Profiles;$profile_name"
        end
    case "cycle-profile-windows"
        argparse 'next' 'prev' -- $argv
        or return 1

        set profile_name $argv[1]
        set -e argv[1]
        set regex (get-profile-regex --browser-only "$profile_name")

        set direction next
        if set -q _flag_prev
            set direction prev
        end

        set current_id (yabai-preset query-windows --window | jq -r '.id')
        or return 1

        set app_window_ids (app-db-query "SELECT window_id FROM apps;")

        if contains -- "$current_id" $app_window_ids
            chrome-trigger-menu-bar "Profiles;$profile_name"
            return
        end

        set windows (yabai-preset list-windows --include-minimized --regex "$regex" | jq -r '.id' | sort -n)
        or return 1

        set count (count $windows)
        set pos (contains --index "$current_id" $windows)
        or return 1

        if test "$direction" = "next"
            set target_pos (math "$pos % $count + 1")
        else
            set target_pos (math "($pos - 2 + $count) % $count + 1")
        end

        set target_id $windows[$target_pos]
        yabai-preset focus-window-id "$target_id"

        # Report where the cycle landed -- {"pos","count","title"} on stdout --
        # so a caller can name it in a HUD (the Hammerspoon binding does, the
        # same way the terminal and devserver rotations announce a step).
        # Silent when focus didn't actually move, i.e. a rotation of one.
        #
        # The title is trimmed down to the page: every browser window ends with
        # " - Google Chrome - <profile>", which is the one part of it the user
        # already knows -- they just asked for this profile by name.
        if test "$target_id" != "$current_id"
            yabai-preset query-windows --window "$target_id" \
                | jq -c --argjson pos "$target_pos" --argjson count "$count" \
                    --arg profile "$profile_name" \
                    '{$pos, $count, title: (.title | rtrimstr(" - " + $profile) | rtrimstr(" - Google Chrome"))}'
        end
    case "toggle-tabbar"
        # Clicks the vertical-tabs Expand/Collapse button (button 1 of group 1
        # of the tab strip's AXTabGroup). The button sits at a fixed relative
        # depth (group 1 x3 below a top-level window group), but WHICH top-level
        # group holds it is not stable: opening the find bar inserts an extra
        # top-level group, shifting the old hardcoded chain onto the find-bar
        # subtree (whose "UI element 3" has no "group 1" -> error -1719). So we
        # scan every top-level group, drill the same relative depth, and click
        # the one that actually contains an AXTabGroup.
        #
        # Act on the focused window rather than `window 1`: Chrome keeps an
        # untitled AXUnknown window around that can sit first in the AX window
        # order, and it holds no groups at all, so `window 1` finds no tab strip
        # and every toggle fails.
        set -l process_ref (chrome-process-ref)
        osascript -e "
            tell application \"System Events\"
                tell $process_ref
                    set targetWindow to missing value
                    try
                        set targetWindow to value of attribute \"AXFocusedWindow\"
                    end try
                    if targetWindow is missing value then set targetWindow to window 1
                    set clicked to false
                    repeat with g in (groups of targetWindow)
                        try
                            set base to group 1 of group 1 of group 1 of g
                            repeat with e in (UI elements of base)
                                if role of e is \"AXTabGroup\" then
                                    click button 1 of group 1 of e
                                    set clicked to true
                                    exit repeat
                                end if
                            end repeat
                        end try
                        if clicked then exit repeat
                    end repeat
                    if not clicked then error \"toggle-tabbar: AXTabGroup not found\"
                end tell
            end tell
        "
    case "debug-instance"
        argparse 'start' 'focus' 'quit' 'is-alive' 'spawn' \
            'user-data-dir=' 'p/port=' 'chrome=' -- $argv
        or return 1

        set -l pid_file "$TMPDIR/chrome_debug.pid"
        set -l chrome_binary (set -q _flag_chrome; and echo "$_flag_chrome"; or echo "/Applications/Chrome Debug.app/Contents/MacOS/Google Chrome")
        set -l user_data_dir (set -q _flag_user_data_dir; and echo "$_flag_user_data_dir"; or echo "$HOME/.local/share/chrome-debug")
        set -l port (set -q _flag_port; and echo "$_flag_port"; or echo "9222")

        set -l action
        if set -q _flag_start
            set action start
        else if set -q _flag_focus
            set action focus
        else if set -q _flag_quit
            set action quit
        else if set -q _flag_is_alive
            set action is-alive
        else
            if pgrep -q -F "$pid_file" 2>/dev/null
                set action focus
            else
                set action start
                set _flag_spawn ""
            end
        end

        switch "$action"
        case "is-alive"
            pgrep -q -F "$pid_file" 2>/dev/null
            return $status
        case "focus"
            yabai-preset focus-pid "$(cat "$pid_file")"
        case "start"
            if pgrep -q -F "$pid_file" 2>/dev/null
                echo "Chrome Debug is already running" >&2
                return 1
            end
            if set -q _flag_spawn
                nohup (status filename) debug-instance --start \
                    --chrome="$chrome_binary" \
                    --user-data-dir="$user_data_dir" \
                    --port="$port" &>/dev/null &
            else
                mkdir -p "$user_data_dir"
                "$chrome_binary" \
                    --remote-debugging-port=$port \
                    --user-data-dir="$user_data_dir" \
                    --no-first-run &
                echo "$last_pid" > "$pid_file"
                wait
                rm -f "$pid_file"
            end
        case "quit"
            kill "$(cat "$pid_file")"
            rm -f "$pid_file"
        end
    case '*'
        return 1
    end
end

chrome-preset $argv
