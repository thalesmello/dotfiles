*.swp
*.swo
tags
stow_modules/main/w3m/history
stow_modules/main/w3m/w3mcache*
stow_modules/main/w3m/w3mtmp*
stow_modules/main/w3m/cookie
stow_modules/main/.Rhistory
stow_modules/main/dot-config/fish/fishd.*
stow_modules/main/dot-config/fish/fundle
stow_modules/main/dot-config/fish/fish_variables
stow_modules/main/dot-config/karabiner/automatic_backups/
stow_modules/main/dot-config/herdr/.plugins.lock
stow_modules/main/dot-config/herdr/sessions/
stow_modules/main/dot-config/herdr/session-snapshots/
stow_modules/main/dot-config/herdr/*.sock
stow_modules/main/dot-config/herdr/*.sock.*
# herdr-snooze.py's per-session identity file, kept next to each herdr socket.
stow_modules/main/dot-config/herdr/.herdr-snooze-session*
stow_modules/main/dot-config/herdr/sessions/*/.herdr-snooze-session*
# `herdr plugin link` registry + per-plugin state: machine-local absolute paths.
# The plugin manifests under plugins/<name>/ are tracked.
stow_modules/main/dot-config/herdr/plugins.json
stow_modules/main/dot-config/herdr/plugins/config/*
# herdr-bar's config is version controlled: it turns on auto tab titles and
# tab status glyphs (both default to off enough to matter in upstream).
!stow_modules/main/dot-config/herdr/plugins/config/herdr-bar/
!stow_modules/main/dot-config/herdr/plugins/config/herdr-bar/config.json
stow_modules/main/dot-config/herdr/*.log
stow_modules/main/dot-config/herdr/session.json
stow_modules/main/dot-config/herdr/session-history.json
stow_modules/main/dot-config/herdr/release-notes.json
stow_modules/main/dot-pi/agent/sessions/
.DS_Store
stow_modules/main/dot-config/nvim/tmp/
.watchman-cookie*
stow_modules/main/dot-hammerspoon/Spoons/EmmyLua.spoon/annotations/
.claude/internet-*
default.profraw
**/__pycache__/**
